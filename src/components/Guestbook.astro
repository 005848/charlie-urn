---
// 留言板组件 - 数据库版本
---

<section id="guestbook" class="py-20 px-6">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-serif text-[#2c2a28] mb-3">留言板</h2>
      <p class="text-sm text-[#9a9690] leading-relaxed">
        如果你也有想诉说的话<br />
        写在这里吧，风会把它们带走
      </p>
    </div>

    <!-- 留言表单 -->
    <form id="guestbook-form" class="mb-12 bg-white border border-[#e5e2dd] rounded-lg p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-[#9a9690] mb-1.5">你的名字</label>
          <input
            type="text"
            id="gb-name"
            required
            maxlength="50"
            placeholder="匿名访客"
            class="w-full px-3 py-2 bg-[#faf9f7] border border-[#e5e2dd] rounded-md text-sm text-[#2c2a28] placeholder-[#c4c0b8] focus:outline-none focus:border-[#b8977a] transition-all duration-300"
          />
        </div>
        <div>
          <label class="block text-xs text-[#9a9690] mb-1.5">邮箱（选填，不公开）</label>
          <input
            type="email"
            id="gb-email"
            maxlength="100"
            placeholder="your@email.com"
            class="w-full px-3 py-2 bg-[#faf9f7] border border-[#e5e2dd] rounded-md text-sm text-[#2c2a28] placeholder-[#c4c0b8] focus:outline-none focus:border-[#b8977a] transition-all duration-300"
          />
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-xs text-[#9a9690] mb-1.5">你想说的话</label>
        <textarea
          id="gb-content"
          required
          maxlength="500"
          rows="4"
          placeholder="写下你想说的话..."
          class="w-full px-3 py-2 bg-[#faf9f7] border border-[#e5e2dd] rounded-md text-sm text-[#2c2a28] placeholder-[#c4c0b8] focus:outline-none focus:border-[#b8977a] transition-all duration-300 resize-none"
        ></textarea>
        <p id="gb-count" class="text-xs text-[#c4c0b8] text-right mt-1">0 / 500</p>
      </div>
      <div class="flex items-center justify-between">
        <p id="gb-message" class="text-xs hidden"></p>
        <button
          type="submit"
          id="gb-submit"
          class="px-6 py-2 bg-[#2c2a28] text-white text-sm rounded-md hover:bg-[#1a1918] transition-all duration-300 disabled:opacity-50"
        >
          留下话
        </button>
      </div>
    </form>

    <!-- 视图切换 -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-medium text-[#2c2a28] dark:text-[#e5e2dd]">留言</h3>
      <div class="flex gap-1 bg-[#f0eeeb] dark:bg-[#2a2826] rounded-md p-1">
        <button id="view-list-btn" class="px-3 py-1 text-xs rounded transition-all duration-300 bg-white dark:bg-[#3a3836] text-[#2c2a28] dark:text-[#faf9f7] shadow-sm">列表</button>
        <button id="view-wall-btn" class="px-3 py-1 text-xs rounded transition-all duration-300 text-[#6b6864] dark:text-[#9a9690] hover:text-[#2c2a28] dark:hover:text-[#e5e2dd]">留言墙</button>
      </div>
    </div>

    <!-- 留言列表 -->
    <div id="guestbook-list" class="space-y-6">
      <p class="text-center text-[#9a9690] text-sm py-8">加载中...</p>
    </div>
  </div>
</section>

<script>
  import { createClient, SupabaseClient } from '@supabase/supabase-js';

  let supabase: SupabaseClient | null = null;
  function getSupabase() {
    if (supabase) return supabase;
    const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
    const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
    if (!url || !anonKey) return null;
    supabase = createClient(url, anonKey);
    return supabase;
  }

  // 简单的头像颜色生成
  function getAvatarColor(name: string): string {
    const colors = ['#b8977a', '#9a9690', '#8c7159', '#d4c4b0', '#a8a095'];
    let hash = 0;
    for (let i = 0; i < name.length; i++) {
      hash = name.charCodeAt(i) + ((hash << 5) - hash);
    }
    return colors[Math.abs(hash) % colors.length];
  }

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor(diff / (1000 * 60));

    if (minutes < 1) return '刚刚';
    if (minutes < 60) return `${minutes} 分钟前`;
    if (hours < 24) return `${hours} 小时前`;
    if (days < 30) return `${days} 天前`;
    return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  async function loadComments() {
    const listEl = document.getElementById('guestbook-list');
    if (!listEl) return;

    const sb = getSupabase();
    if (!sb) {
      listEl.innerHTML = `<p class="text-center text-[#9a9690] text-sm py-8">数据库未配置</p>`;
      return;
    }

    try {
      const { data: comments, error } = await sb
        .from('guestbook_comments')
        .select('*')
        .eq('status', 'approved')
        .order('created_at', { ascending: false })
        .limit(50);

      if (error) throw error;

      if (!comments || comments.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-8">
            <p class="text-[#9a9690] text-sm">还没有人留言</p>
            <p class="text-[#c4c0b8] text-xs mt-2">来说点什么吧</p>
          </div>
        `;
        return;
      }

      listEl.innerHTML = comments.map((c: any) => `
        <div class="comment-item bg-white border border-[#e5e2dd] rounded-lg p-5 animate-fade-in">
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-medium shrink-0" style="background: ${getAvatarColor(c.author_name)}">
              ${escapeHtml(c.author_name?.charAt(0) || '?')}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-medium text-[#2c2a28]">${escapeHtml(c.author_name)}</span>
                <span class="text-xs text-[#c4c0b8]">${formatDate(c.created_at)}</span>
              </div>
              <p class="text-sm text-[#2c2a28] leading-relaxed whitespace-pre-wrap break-words">${escapeHtml(c.content)}</p>
            </div>
          </div>
        </div>
      `).join('');
    } catch (err) {
      console.error('加载留言失败', err);
      listEl.innerHTML = `<p class="text-center text-[#9a9690] text-sm py-8">加载失败，请刷新重试</p>`;
    }
  }

  // 表单提交
  const form = document.getElementById('guestbook-form') as HTMLFormElement;
  const contentTextarea = document.getElementById('gb-content') as HTMLTextAreaElement;
  const countEl = document.getElementById('gb-count');

  contentTextarea?.addEventListener('input', () => {
    if (countEl) countEl.textContent = `${contentTextarea.value.length} / 500`;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('gb-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('gb-email') as HTMLInputElement).value.trim();
    const content = contentTextarea.value.trim();
    const submitBtn = document.getElementById('gb-submit') as HTMLButtonElement;
    const msgEl = document.getElementById('gb-message')!;

    if (!name || !content) return;

    const sb = getSupabase();
    if (!sb) {
      msgEl.textContent = '数据库未配置，无法留言';
      msgEl.className = 'text-xs text-red-500';
      msgEl.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '发送中...';
    msgEl.classList.add('hidden');

    try {
      const { error } = await sb
        .from('guestbook_comments')
        .insert({
          author_name: name,
          author_email: email || null,
          content,
          status: 'pending',
        });

      if (error) throw error;

      msgEl.textContent = '留言已提交，审核通过后会显示';
      msgEl.className = 'text-xs text-[#b8977a]';
      msgEl.classList.remove('hidden');
      form.reset();
      if (countEl) countEl.textContent = '0 / 500';
      loadComments();
    } catch (err: any) {
      console.error('留言失败', err);
      msgEl.textContent = err?.message || '留言失败，请重试';
      msgEl.className = 'text-xs text-red-500';
      msgEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '留下话';
    }
  });

  // 初始加载
  loadComments();

  // 视图切换
  const listBtn = document.getElementById('view-list-btn');
  const wallBtn = document.getElementById('view-wall-btn');
  const listContainer = document.getElementById('guestbook-list');

  function setView(view) {
    if (view === 'wall') {
      listContainer.className = 'guestbook-wall';
      wallBtn.className = 'px-3 py-1 text-xs rounded transition-all duration-300 bg-white dark:bg-[#3a3836] text-[#2c2a28] dark:text-[#faf9f7] shadow-sm';
      listBtn.className = 'px-3 py-1 text-xs rounded transition-all duration-300 text-[#6b6864] dark:text-[#9a9690] hover:text-[#2c2a28] dark:hover:text-[#e5e2dd]';
    } else {
      listContainer.className = 'space-y-6';
      listBtn.className = 'px-3 py-1 text-xs rounded transition-all duration-300 bg-white dark:bg-[#3a3836] text-[#2c2a28] dark:text-[#faf9f7] shadow-sm';
      wallBtn.className = 'px-3 py-1 text-xs rounded transition-all duration-300 text-[#6b6864] dark:text-[#9a9690] hover:text-[#2c2a28] dark:hover:text-[#e5e2dd]';
    }
  }

  listBtn?.addEventListener('click', () => setView('list'));
  wallBtn?.addEventListener('click', () => setView('wall'));
</script>
