---
---

<section class="guestbook-section" id="guestbook">
  <div class="section-header">
    <span class="section-symbol">❀</span>
    <h2 class="section-title">留言板</h2>
    <p class="section-subtitle">留下你的话语，让思念有处安放</p>
  </div>

  <form class="comment-form" id="commentForm">
    <div class="form-row">
      <div class="form-group">
        <label for="commentName">你的名字</label>
        <input type="text" id="commentName" name="name" placeholder="匿名的朋友" maxlength="20" />
      </div>
      <div class="form-group">
        <label for="commentEmail">邮箱 <span class="optional">(选填)</span></label>
        <input type="email" id="commentEmail" name="email" placeholder="不会公开显示" />
      </div>
    </div>
    <div class="form-group">
      <label for="commentContent">留言内容</label>
      <textarea id="commentContent" name="content" rows="4" placeholder="写下你想说的话..." maxlength="500" required></textarea>
      <div class="char-count"><span id="charCount">0</span>/500</div>
    </div>
    <button type="submit" class="submit-btn">
      <span>留下思念</span>
      <span class="btn-icon">→</span>
    </button>
  </form>

  <div class="comments-list" id="commentsList">
    <h3 class="comments-title">所有留言 <span class="comments-count" id="commentsCount">0</span></h3>
    <div class="comments-empty" id="commentsEmpty">
      <p>还没有留言，来写下第一句吧</p>
    </div>
    <div class="comments-container" id="commentsContainer"></div>
  </div>
</section>

<style>
.guestbook-section {
  max-width: 680px;
  margin: 0 auto;
  padding: 80px 24px;
}

.section-header {
  text-align: center;
  margin-bottom: 48px;
}

.section-symbol {
  font-size: 1.2rem;
  color: var(--color-accent-primary);
  margin-bottom: 16px;
  display: block;
}

.section-title {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 12px;
  letter-spacing: 0.05em;
}

.section-subtitle {
  font-size: 0.9rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.05em;
}

.comment-form {
  background-color: var(--color-bg-secondary);
  padding: 32px;
  border-radius: 8px;
  margin-bottom: 48px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.form-group {
  margin-bottom: 20px;
  position: relative;
}

.form-row .form-group {
  margin-bottom: 0;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  color: var(--color-text-secondary);
  margin-bottom: 8px;
  letter-spacing: 0.03em;
}

.optional {
  color: var(--color-text-tertiary);
  font-size: 0.75rem;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-family: inherit;
  font-size: 0.9rem;
  transition: all 0.3s var(--ease-smooth);
  outline: none;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--color-accent-primary);
  background-color: #fff;
}

.form-group textarea {
  resize: vertical;
  min-height: 100px;
  line-height: 1.6;
}

.char-count {
  position: absolute;
  right: 8px;
  bottom: -18px;
  font-size: 0.7rem;
  color: var(--color-text-tertiary);
}

.submit-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  background-color: var(--color-accent-primary);
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 0.9rem;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.3s var(--ease-smooth);
  letter-spacing: 0.05em;
}

.submit-btn:hover {
  background-color: var(--color-accent-hover);
  transform: translateY(-1px);
}

.submit-btn:active {
  transform: translateY(0);
}

.btn-icon {
  transition: transform 0.3s var(--ease-smooth);
}

.submit-btn:hover .btn-icon {
  transform: translateX(4px);
}

.comments-list {
  border-top: 1px solid var(--color-border-soft);
  padding-top: 48px;
}

.comments-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 24px;
}

.comments-count {
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
  font-weight: 400;
  margin-left: 8px;
}

.comments-empty {
  text-align: center;
  padding: 48px 0;
  color: var(--color-text-tertiary);
  font-size: 0.9rem;
}

.comments-container {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.comment-item {
  padding: 20px;
  background-color: var(--color-bg-secondary);
  border-radius: 8px;
  animation: fadeInUp 0.5s var(--ease-smooth) both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.comment-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: var(--color-accent-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  color: var(--color-text-primary);
  font-weight: 500;
  flex-shrink: 0;
}

.comment-author {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text-primary);
}

.comment-date {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  margin-left: auto;
}

.comment-content {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  padding-left: 42px;
}

@media (max-width: 640px) {
  .guestbook-section {
    padding: 48px 16px;
  }

  .comment-form {
    padding: 20px;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .form-row .form-group:last-child {
    margin-bottom: 20px;
  }

  .section-title {
    font-size: 1.4rem;
  }
}
</style>

<script>
  const STORAGE_KEY = 'charlie_urn_comments';

  interface Comment {
    id: string;
    name: string;
    content: string;
    date: string;
  }

  function loadComments(): Comment[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : getDefaultComments();
    } catch {
      return getDefaultComments();
    }
  }

  function getDefaultComments(): Comment[] {
    return [
      {
        id: '1',
        name: '路人甲',
        content: '偶然路过这里，被文字间的温柔打动了。愿所有思念都能抵达想去的地方。',
        date: new Date(Date.now() - 86400000 * 3).toISOString(),
      },
      {
        id: '2',
        name: '小满',
        content: '看到某篇文章的时候，突然想起了自己的爷爷。谢谢你把这些记忆写下来。',
        date: new Date(Date.now() - 86400000).toISOString(),
      },
    ];
  }

  function saveComments(comments: Comment[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
  }

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

    if (days === 0) return '今天';
    if (days === 1) return '昨天';
    if (days < 7) return `${days}天前`;

    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}.${month}.${day}`;
  }

  function getInitial(name: string): string {
    return name.charAt(0).toUpperCase() || '匿';
  }

  function renderComments() {
    const comments = loadComments().sort(
      (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
    );

    const container = document.getElementById('commentsContainer');
    const empty = document.getElementById('commentsEmpty');
    const count = document.getElementById('commentsCount');

    if (!container || !empty || !count) return;

    count.textContent = String(comments.length);

    if (comments.length === 0) {
      empty.style.display = 'block';
      container.innerHTML = '';
      return;
    }

    empty.style.display = 'none';
    container.innerHTML = comments.map(
      (comment) => `
        <div class="comment-item">
          <div class="comment-header">
            <div class="comment-avatar">${getInitial(comment.name)}</div>
            <span class="comment-author">${escapeHtml(comment.name)}</span>
            <span class="comment-date">${formatDate(comment.date)}</span>
          </div>
          <p class="comment-content">${escapeHtml(comment.content)}</p>
        </div>
      `
    ).join('');
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderComments();

    const form = document.getElementById('commentForm');
    const textarea = document.getElementById('commentContent') as HTMLTextAreaElement;
    const charCount = document.getElementById('charCount');

    if (textarea && charCount) {
      textarea.addEventListener('input', () => {
        charCount.textContent = String(textarea.value.length);
      });
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('commentName') as HTMLInputElement;
        const contentInput = document.getElementById('commentContent') as HTMLTextAreaElement;

        const name = nameInput?.value.trim() || '匿名的朋友';
        const content = contentInput?.value.trim();

        if (!content) return;

        const comments = loadComments();
        comments.unshift({
          id: Date.now().toString(),
          name,
          content,
          date: new Date().toISOString(),
        });

        saveComments(comments);
        renderComments();

        if (contentInput) contentInput.value = '';
        if (charCount) charCount.textContent = '0';
      });
    }
  });
</script>
