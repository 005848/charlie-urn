---
import FormattedDate from './FormattedDate.astro';
import { CATEGORIES } from '../consts';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags?: string[];
    };
  };
}

const { post } = Astro.props;
const categoryInfo = CATEGORIES.find(c => c.id === post.data.category) || CATEGORIES[0];
---

<article class="post-card">
  <a href={`/post?slug=${post.slug}`} class="post-card-link">
    <div class="post-card-inner">
      <div class="post-card-header">
        <span class="post-category">
          <span class="category-icon">{categoryInfo.icon}</span>
          <span class="category-label">{categoryInfo.label}</span>
        </span>
        <span class="post-date">
          <FormattedDate date={post.data.pubDate} format="short" />
        </span>
      </div>

      <h3 class="post-title">{post.data.title}</h3>

      <p class="post-excerpt">{post.data.description}</p>

      <div class="post-card-footer">
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
        <span class="read-more">阅读 →</span>
      </div>
    </div>
  </a>
</article>

<style>
.post-card {
  position: relative;
  transition: transform 0.4s var(--ease-smooth);
}

.post-card:hover {
  transform: translateY(-2px);
}

.post-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.post-card-inner {
  padding: 28px 0;
  border-bottom: 1px solid var(--color-border-soft);
  position: relative;
}

.post-card-inner::before {
  content: '';
  position: absolute;
  left: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 0;
  background-color: var(--color-accent-primary);
  border-radius: 2px;
  transition: height 0.4s var(--ease-smooth);
}

.post-card:hover .post-card-inner::before {
  height: 60%;
}

.post-card-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 12px;
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
}

.post-category {
  display: flex;
  align-items: center;
  gap: 6px;
}

.category-icon {
  color: var(--color-accent-primary);
  font-size: 0.85rem;
}

.category-label {
  letter-spacing: 0.05em;
}

.post-date {
  font-variant-numeric: tabular-nums;
}

.post-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 500;
  line-height: 1.5;
  color: var(--color-text-primary);
  margin-bottom: 10px;
  transition: color 0.3s var(--ease-smooth);
}

.post-card:hover .post-title {
  color: var(--color-accent-hover);
}

.post-excerpt {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.post-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.tag {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.02em;
}

.read-more {
  font-size: 0.8rem;
  color: var(--color-accent-primary);
  letter-spacing: 0.05em;
  transition: transform 0.3s var(--ease-smooth);
  flex-shrink: 0;
}

.post-card:hover .read-more {
  transform: translateX(4px);
}

@media (max-width: 768px) {
  .post-card-inner {
    padding: 20px 0;
  }

  .post-title {
    font-size: 1.1rem;
  }

  .post-excerpt {
    -webkit-line-clamp: 3;
  }
}
</style>
