---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  coverImage?: string;
  category?: string;
  tags?: string[];
  postId?: string;
  viewCount?: number;
  likeCount?: number;
}

const { title, description, pubDate, updatedDate, coverImage, category, tags = [], postId, viewCount = 0, likeCount = 0, weather, mood, unlockDate } = Astro.props;
const isLocked = unlockDate && new Date(unlockDate) > new Date();
const daysUntil = unlockDate ? Math.ceil((new Date(unlockDate) - new Date()) / (1000 * 60 * 60 * 24)) : 0;
---

<Layout title={title} description={description}>
  <!-- 阅读进度条 -->
  <div id="reading-progress" class="reading-progress">
    <div class="progress-bar"></div>
  </div>

  <article class="article-page">
    {coverImage && (
      <div class="article-cover">
        <img src={coverImage} alt={title} fetchpriority="high" />
        <div class="cover-overlay"></div>
      </div>
    )}

    <header class="article-header">
      <div class="header-inner">
        <a href="/blog" class="back-link">← 返回目录</a>

        {category && (
          <div class="article-meta-top">
            <span class="article-category">{category}</span>
            <span class="article-date">
              <FormattedDate date={pubDate} />
            </span>
          </div>
        )}

        <h1 class="article-title">{title}</h1>

        <p class="article-description">{description}</p>

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="tag-item">#{tag}</span>
            ))}
          </div>
        )}

        <div class="article-stats">
          <span class="stat-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span id="view-count-display">{viewCount}</span>
          </span>
          <span class="stat-item like-button" data-post-id={postId} id="like-button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span id="like-count-display">{likeCount}</span>
          </span>
        </div>
      </div>
    </header>

    <!-- 天气/心情 -->
    {(weather || mood) && (
      <div class="article-meta-bar">
        {weather && <span class="meta-item weather">☀️ {weather}</span>}
        {mood && <span class="meta-item mood">💭 {mood}</span>}
      </div>
    )}

    <div class="article-body" class:list={['locked', isLocked]}>
      <div class="prose-custom">
        <slot />
      </div>

      <!-- 时间胶囊未解锁遮罩 -->
      {isLocked && (
        <div class="capsule-overlay">
          <div class="capsule-content">
            <div class="capsule-icon">🔒</div>
            <h3 class="capsule-title">这是一封写给未来的信</h3>
            <p class="capsule-desc">距离解锁还有 <strong>{daysUntil}</strong> 天</p>
            <p class="capsule-date">解锁时间：<FormattedDate date={unlockDate!} /></p>
            <div class="capsule-countdown" id="capsule-countdown"></div>
          </div>
        </div>
      )}
    </div>

    <footer class="article-footer">
      <div class="footer-inner">
        <div class="footer-divider">
          <span class="divider-dot"></span>
        </div>

        {updatedDate && (
          <p class="updated-note">
            最后更新于 <FormattedDate date={updatedDate} />
          </p>
        )}

        <div class="footer-nav">
          <a href="/blog" class="footer-link">查看更多文章 →</a>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<script>
  // 阅读进度条
  const progressBar = document.querySelector('.reading-progress .progress-bar') as HTMLElement;
  if (progressBar) {
    const updateProgress = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${progress}%`;
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // 点赞功能
  const likeButton = document.getElementById('like-button');
  const likeCountDisplay = document.getElementById('like-count-display');
  const postId = likeButton?.getAttribute('data-post-id');

  if (likeButton && postId && likeCountDisplay) {
    const getVisitorId = () => {
      let id = localStorage.getItem('charlie_visitor_id');
      if (!id) {
        id = 'v_' + Math.random().toString(36).substring(2, 15);
        localStorage.setItem('charlie_visitor_id', id);
      }
      return id;
    };

    const visitorId = getVisitorId();
    const likedKey = `liked_${postId}`;
    let isLiked = localStorage.getItem(likedKey) === '1';

    const updateLikeUI = () => {
      if (isLiked) {
        likeButton.classList.add('liked');
      } else {
        likeButton.classList.remove('liked');
      }
    };
    updateLikeUI();

    likeButton.addEventListener('click', async () => {
      try {
        const supabaseUrl = document.querySelector('meta[name="x-supabase-url"]')?.getAttribute('content') || '';
        const anonKey = document.querySelector('meta[name="x-supabase-anon-key"]')?.getAttribute('content') || '';
        if (!supabaseUrl || !anonKey) return;

        const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
        const supabase = createClient(supabaseUrl, anonKey);

        if (isLiked) {
          // 取消点赞
          const { error: delError } = await supabase
            .from('post_likes')
            .delete()
            .eq('post_id', postId)
            .eq('visitor_id', visitorId);
          
          if (!delError) {
            const { error } = await supabase.rpc('decrement_like_count', { post_id_param: postId });
            if (!error) {
              isLiked = false;
              localStorage.removeItem(likedKey);
              likeCountDisplay.textContent = String(parseInt(likeCountDisplay.textContent) - 1);
              updateLikeUI();
            }
          }
        } else {
          // 点赞
          const { error: insError } = await supabase
            .from('post_likes')
            .insert({ post_id: postId, visitor_id: visitorId });
          
          if (!insError) {
            const { error } = await supabase.rpc('increment_like_count', { post_id_param: postId });
            if (!error) {
              isLiked = true;
              localStorage.setItem(likedKey, '1');
              likeCountDisplay.textContent = String(parseInt(likeCountDisplay.textContent) + 1);
              updateLikeUI();
            }
          }
        }
      } catch(e) {
        console.error('点赞失败:', e);
      }
    });

    // 打字机效果（文章首段）
    const firstParagraph = document.querySelector('.prose-custom p:first-of-type');
    if (firstParagraph && firstParagraph.textContent.length < 200) {
      const text = firstParagraph.textContent;
      firstParagraph.textContent = '';
      firstParagraph.style.opacity = '1';
      let i = 0;
      const typeWriter = () => {
        if (i < text.length) {
          firstParagraph.textContent += text.charAt(i);
          i++;
          setTimeout(typeWriter, 30);
        }
      };
      setTimeout(typeWriter, 500);
    }
  }
</script>

<style>
.article-page {
  max-width: 100%;
}

.reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  z-index: 100;
  background: transparent;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent-primary), var(--color-accent-secondary));
  width: 0%;
  transition: width 0.1s linear;
}

.article-cover {
  position: relative;
  width: 100%;
  height: 400px;
  overflow: hidden;
}

.article-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(transparent, var(--color-bg-primary));
}

.article-header {
  padding: 60px 24px 40px;
  background: linear-gradient(
    180deg,
    var(--color-bg-secondary) 0%,
    var(--color-bg-primary) 100%
  );
}

:global(.dark) .article-header {
  background: linear-gradient(
    180deg,
    var(--color-bg-tertiary) 0%,
    var(--color-bg-primary) 100%
  );
}

.header-inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}

.back-link {
  display: inline-block;
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
  text-decoration: none;
  margin-bottom: 24px;
  transition: color 0.3s var(--ease-smooth);
}

.back-link:hover {
  color: var(--color-accent-primary);
}

.article-meta-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-bottom: 20px;
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
}

.article-category {
  color: var(--color-accent-primary);
  letter-spacing: 0.05em;
}

.article-date {
  letter-spacing: 0.03em;
}

.article-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 5vw, 2.5rem);
  font-weight: 500;
  line-height: 1.4;
  color: var(--color-text-primary);
  margin-bottom: 16px;
  letter-spacing: 0.03em;
}

.article-description {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--color-text-secondary);
  font-style: italic;
  margin-bottom: 20px;
}

.article-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.tag-item {
  font-size: 0.8rem;
  color: var(--color-accent-primary);
  letter-spacing: 0.03em;
}

.article-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24px;
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.like-button {
  cursor: pointer;
  transition: all 0.3s var(--ease-smooth);
  user-select: none;
}

.like-button:hover {
  color: var(--color-accent-primary);
  transform: scale(1.1);
}

.like-button.liked {
  color: var(--color-accent-primary);
}

.like-button.liked svg {
  fill: var(--color-accent-primary);
}

.article-body {
  padding: 40px 24px;
}

.article-footer {
  padding: 40px 24px 80px;
}

.footer-inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}

.footer-divider {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32px;
}

.divider-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--color-border);
  position: relative;
}

.divider-dot::before,
.divider-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 80px;
  height: 1px;
  background: var(--color-border);
}

.divider-dot::before { right: 12px; }
.divider-dot::after { left: 12px; }

.updated-note {
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
  margin-bottom: 24px;
}

.footer-nav {
  margin-top: 24px;
}

.footer-link {
  color: var(--color-accent-primary);
  text-decoration: none;
  font-size: 0.9rem;
  transition: opacity 0.3s var(--ease-smooth);
}

.footer-link:hover {
  opacity: 0.7;
}

@media (max-width: 640px) {
  .article-cover { height: 250px; }
  .article-header { padding: 40px 16px 32px; }
  .article-body { padding: 32px 16px; }
  .article-footer { padding: 32px 16px 60px; }
}

/* 天气心情 */
.article-meta-bar {
  display: flex;
  gap: 20px;
  padding: 12px 20px;
  margin: 20px auto 0;
  max-width: 680px;
  background: var(--bg-secondary);
  border-radius: 8px;
  font-size: 0.9rem;
  color: var(--text-secondary);
  justify-content: center;
}
.meta-item { display: flex; align-items: center; gap: 6px; }

/* 时间胶囊 */
.article-body.locked { position: relative; filter: blur(8px); max-height: 400px; overflow: hidden; pointer-events: none; }
.capsule-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(250,249,247,0.3) 0%, rgba(250,249,247,0.95) 100%);
  z-index: 10;
  pointer-events: auto;
}
html[data-theme="dark"] .capsule-overlay {
  background: linear-gradient(180deg, rgba(28,26,24,0.3) 0%, rgba(28,26,24,0.95) 100%);
}
.capsule-content { text-align: center; padding: 40px; }
.capsule-icon { font-size: 3rem; margin-bottom: 16px; }
.capsule-title { font-family: "Noto Serif SC", serif; font-size: 1.5rem; font-weight: 500; margin: 0 0 12px; color: var(--text-primary); }
.capsule-desc { font-size: 1rem; color: var(--text-secondary); margin: 0 0 8px; }
.capsule-desc strong { color: var(--accent-primary); font-size: 1.2rem; }
.capsule-date { font-size: 0.875rem; color: var(--text-tertiary); margin: 0 0 16px; }
.capsule-countdown { font-family: "Inter", monospace; font-size: 0.875rem; color: var(--accent-primary); letter-spacing: 1px; }

/* 打字机光标 */
.typing-cursor::after {
  content: '|';
  display: inline-block;
  margin-left: 2px;
  color: var(--accent-primary);
  animation: blink 1s step-end infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
</style>
