---
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CATEGORIES } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: any;
  category: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, category, tags = [] } = Astro.props;

const categoryInfo = CATEGORIES.find(c => c.id === category) || CATEGORIES[0];
---

<Layout title={title} description={description}>
  <article class="article-page">
    <header class="article-header">
      <div class="header-inner">
        <a href="/blog" class="back-link">← 返回目录</a>

        <div class="article-meta-top">
          <span class="article-category">
            <span class="cat-icon">{categoryInfo.icon}</span>
            <span>{categoryInfo.label}</span>
          </span>
          <span class="article-date">
            <FormattedDate date={pubDate} />
          </span>
        </div>

        <h1 class="article-title">{title}</h1>

        <p class="article-description">{description}</p>

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="tag-item">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="article-body">
      <div class="prose-custom">
        <slot />
      </div>
    </div>

    <footer class="article-footer">
      <div class="footer-inner">
        <div class="footer-divider">
          <span class="divider-dot"></span>
        </div>

        {updatedDate && (
          <p class="updated-note">
            最后更新于 <FormattedDate date={updatedDate} />
          </p>
        )}

        <div class="footer-nav">
          <a href="/blog" class="footer-link">查看更多文章 →</a>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
.article-page {
  max-width: 100%;
}

.article-header {
  padding: 80px 24px 48px;
  background: linear-gradient(
    180deg,
    var(--color-bg-secondary) 0%,
    var(--color-bg-primary) 100%
  );
}

.header-inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}

.back-link {
  display: inline-block;
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
  text-decoration: none;
  margin-bottom: 32px;
  transition: color 0.3s var(--ease-smooth);
}

.back-link:hover {
  color: var(--color-accent-primary);
}

.article-meta-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-bottom: 24px;
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
}

.article-category {
  display: flex;
  align-items: center;
  gap: 6px;
}

.cat-icon {
  color: var(--color-accent-primary);
  font-size: 0.9rem;
}

.article-date {
  letter-spacing: 0.03em;
}

.article-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 5vw, 2.5rem);
  font-weight: 500;
  line-height: 1.4;
  color: var(--color-text-primary);
  margin-bottom: 20px;
  letter-spacing: 0.03em;
}

.article-description {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--color-text-secondary);
  font-style: italic;
  margin-bottom: 28px;
}

.article-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
}

.tag-item {
  font-size: 0.8rem;
  color: var(--color-accent-primary);
  letter-spacing: 0.03em;
}

.article-body {
  padding: 48px 24px;
}

.article-footer {
  padding: 48px 24px 80px;
}

.footer-inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}

.footer-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
}

.divider-dot {
  width: 6px;
  height: 6px;
  background-color: var(--color-accent-primary);
  border-radius: 50%;
  position: relative;
}

.divider-dot::before,
.divider-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60px;
  height: 1px;
  background-color: var(--color-border);
}

.divider-dot::before {
  right: 16px;
}

.divider-dot::after {
  left: 16px;
}

.updated-note {
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
  margin-bottom: 24px;
}

.footer-nav {
  margin-top: 16px;
}

.footer-link {
  display: inline-block;
  font-size: 0.9rem;
  color: var(--color-accent-primary);
  text-decoration: none;
  transition: color 0.3s var(--ease-smooth);
}

.footer-link:hover {
  color: var(--color-accent-hover);
}

@media (max-width: 768px) {
  .article-header {
    padding: 48px 16px 32px;
  }

  .article-body {
    padding: 32px 16px;
  }

  .article-footer {
    padding: 32px 16px 60px;
  }
}
</style>
