---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在" description="您访问的页面不存在">
  <div class="not-found-page">
    <div class="not-found-inner">
      <div class="not-found-icon">◇</div>
      <h1 class="not-found-title">404</h1>
      <p class="not-found-desc">您访问的页面不存在</p>
      <a href="/" class="back-home-btn">返回首页</a>
    </div>
  </div>
</Layout>

<style>
  .not-found-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .not-found-inner {
    text-align: center;
    padding: 3rem 1.5rem;
  }
  .not-found-icon {
    font-size: 3rem;
    color: var(--color-accent, #b8977a);
    margin-bottom: 1.5rem;
    opacity: 0.6;
  }
  .not-found-title {
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 5rem;
    font-weight: 300;
    color: var(--color-primary, #2c2a28);
    margin: 0 0 1rem 0;
    line-height: 1;
  }
  .not-found-desc {
    font-size: 1.125rem;
    color: var(--color-secondary, #6b6864);
    margin-bottom: 2rem;
  }
  .back-home-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 1px solid var(--color-accent, #b8977a);
    color: var(--color-accent, #b8977a);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .back-home-btn:hover {
    background-color: var(--color-accent, #b8977a);
    color: white;
  }
</style>
