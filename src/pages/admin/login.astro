---
import Layout from '@layouts/Layout.astro';
---

<Layout title="登录 - 管理后台">
  <main class="min-h-screen flex items-center justify-center px-4 bg-[#faf9f7]">
    <div class="w-full max-w-md animate-fade-in">
      <div class="text-center mb-12">
        <h1 class="text-2xl font-serif text-[#2c2a28] mb-2">管理入口</h1>
        <p class="text-sm text-[#9a9690]">请输入管理员邮箱和密码</p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-xs text-[#9a9690] mb-1.5">邮箱</label>
          <input
            type="email"
            id="email"
            placeholder="admin@charlie.urn"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-md text-[#2c2a28] placeholder-[#9a9690] focus:outline-none focus:border-[#b8977a] focus:ring-1 focus:ring-[#b8977a] transition-all duration-300"
            required
          />
        </div>
        <div>
          <label class="block text-xs text-[#9a9690] mb-1.5">密码</label>
          <input
            type="password"
            id="password"
            placeholder="请输入密码"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-md text-[#2c2a28] placeholder-[#9a9690] focus:outline-none focus:border-[#b8977a] focus:ring-1 focus:ring-[#b8977a] transition-all duration-300"
            required
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 bg-[#2c2a28] text-white rounded-md font-medium hover:bg-[#1a1918] transition-all duration-300 disabled:opacity-50 mt-6"
        >
          登录
        </button>
        <p id="error-msg" class="text-center text-red-500 text-sm hidden"></p>
      </form>

      <p class="text-center text-xs text-[#9a9690] mt-8">
        <a href="/" class="hover:text-[#b8977a] transition-colors duration-300">← 返回首页</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { createClient, SupabaseClient } from '@supabase/supabase-js';

  let supabase: SupabaseClient | null = null;
  function getSupabase() {
    if (supabase) return supabase;
    const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
    const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
    if (!url || !anonKey) return null;
    supabase = createClient(url, anonKey);
    return supabase;
  }

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const sb = getSupabase();
    if (!sb) {
      errorMsg.textContent = 'Supabase 未配置';
      errorMsg.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '登录中...';
    errorMsg.classList.add('hidden');

    try {
      const { data, error } = await sb.auth.signInWithPassword({ email, password });

      if (error) throw error;

      if (data?.user) {
        // 检查用户是否是管理员
        const { data: profile, error: profileError } = await sb
          .from('auth.users')
          .select('raw_user_meta_data')
          .eq('id', data.user.id)
          .single();

        // 即使查不到也允许登录（admin 角色通过 RLS 控制）
        // 这里直接跳转到后台
        window.location.href = '/admin';
      }
    } catch (err: any) {
      errorMsg.textContent = err?.message || '登录失败，请检查邮箱和密码';
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '登录';
    }
  });

  // 已登录直接跳转
  (async () => {
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (data?.session) {
      window.location.href = '/admin';
    }
  })();
</script>
