---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="媒体库 - 管理后台">
  <div class="min-h-screen bg-[#faf9f7]">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-medium text-[#2c2a28] mb-1">媒体库</h1>
          <p class="text-sm text-[#9a9690]">管理所有上传的图片、视频和音频文件</p>
        </div>
        <a href="/admin" class="text-sm text-[#6b6864] hover:text-[#b8977a] transition-colors">← 返回后台</a>
      </div>

      <!-- 上传区域 -->
      <div class="bg-white border border-[#e5e2dd] rounded-xl p-8 mb-8 text-center">
        <div class="text-4xl mb-4">📁</div>
        <p class="text-[#6b6864] mb-4">拖拽文件到此处，或点击下方按钮上传</p>
        <div class="flex items-center justify-center gap-3">
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🖼️ 上传图片
            <input type="file" accept="image/*" multiple class="hidden" id="upload-image-btn" />
          </label>
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🎬 上传视频
            <input type="file" accept="video/*" class="hidden" id="upload-video-btn" />
          </label>
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🎵 上传音频
            <input type="file" accept="audio/*" class="hidden" id="upload-audio-btn" />
          </label>
        </div>
        <div id="upload-status" class="mt-4 text-sm text-[#9a9690] hidden">
          正在上传... <span id="upload-progress">0%</span>
        </div>
      </div>

      <!-- 文件列表 -->
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-medium text-[#2c2a28]">全部文件</h2>
        <span id="file-count" class="text-sm text-[#9a9690]">加载中...</span>
      </div>

      <!-- 筛选 + 搜索 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2 flex-wrap">
          <button data-filter="all" class="filter-btn active px-3 py-1.5 text-sm rounded-lg border transition-all">全部</button>
          <button data-filter="image" class="filter-btn px-3 py-1.5 text-sm rounded-lg border transition-all">图片</button>
          <button data-filter="video" class="filter-btn px-3 py-1.5 text-sm rounded-lg border transition-all">视频</button>
          <button data-filter="audio" class="filter-btn px-3 py-1.5 text-sm rounded-lg border transition-all">音频</button>
        </div>
        <div class="relative">
          <input type="text" id="media-search" placeholder="搜索文件名..." class="pl-9 pr-4 py-1.5 text-sm border rounded-lg w-full sm:w-56 focus:outline-none focus:ring-2 focus:ring-[#b8977a]/30" />
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[#9a9690]">🔍</span>
        </div>
      </div>

      <div id="media-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <div class="col-span-full text-center py-12 text-[#9a9690]">
          加载中...
        </div>
      </div>

      <!-- 图片预览灯箱 -->
      <div id="media-lightbox" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4" onclick="closeMediaLightbox()">
        <button onclick="closeMediaLightbox()" class="absolute top-4 right-4 text-white text-2xl w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors">×</button>
        <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors">‹</button>
        <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors">›</button>
        <img id="lightbox-img" class="max-w-full max-h-[85vh] object-contain rounded-lg" onclick="event.stopPropagation()" />
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-sm bg-black/50 px-4 py-2 rounded-full">
          <span id="lightbox-name"></span>
          <button onclick="downloadLightboxImage()" class="ml-4 px-3 py-1 bg-white/20 hover:bg-white/30 rounded-full transition-colors">下载</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .filter-btn {
      border-color: var(--color-border);
      background: var(--color-bg-primary);
      color: var(--color-text-secondary);
    }
    .filter-btn:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    .filter-btn.active {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: #fff;
    }
    #media-search {
      background: var(--color-bg-primary);
      border-color: var(--color-border);
      color: var(--color-text-primary);
    }
    #media-search:focus {
      border-color: var(--color-accent);
    }
  </style>

  <script>
    import { getSupabase, uploadFile, listMediaFiles, deleteMediaFile, getFileType, getPublicUrl } from '../../lib/supabase/client';

    const supabase = getSupabase();

    // 鉴权检查
    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
        return false;
      }
      return true;
    }

    checkAuth().then(isAdmin => {
      if (isAdmin) loadMedia();
    });

    // 筛选和搜索状态
    let allFiles: any[] = [];
    let currentFilter = 'all';
    let searchQuery = '';

    // 筛选按钮
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        renderFiles();
      });
    });

    // 搜索输入
    document.getElementById('media-search')?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      renderFiles();
    });

    function getFileType(name: string): string {
      if (/\.(jpg|jpeg|png|gif|webp|svg)$/i.test(name)) return 'image';
      if (/\.(mp4|webm|ogg|mov)$/i.test(name)) return 'video';
      if (/\.(mp3|wav|ogg|m4a|flac)$/i.test(name)) return 'audio';
      return 'other';
    }

    function renderFiles() {
      const gridEl = document.getElementById('media-grid');
      const countEl = document.getElementById('file-count');
      if (!gridEl) return;

      let files = allFiles.filter(f => f.name !== '.emptyFolderPlaceholder');

      // 类型筛选
      if (currentFilter !== 'all') {
        files = files.filter(f => getFileType(f.name) === currentFilter);
      }

      // 搜索筛选
      if (searchQuery) {
        files = files.filter(f => f.name.toLowerCase().includes(searchQuery));
      }

      if (countEl) countEl.textContent = `共 ${files.length} 个文件`;

      if (files.length === 0) {
        gridEl.innerHTML = `
          <div class="col-span-full text-center py-12 text-[#9a9690]">
            ${allFiles.length === 0 ? '还没有上传任何文件' : '没有找到匹配的文件'}
          </div>
        `;
        return;
      }

      gridEl.innerHTML = files.map((file, idx) => {
        const url = getPublicUrl(file.name);
        const type = getFileType(file.name);

        let preview = '';
        if (type === 'image') {
          preview = `<img src="${url}" alt="${file.name}" class="w-full h-40 object-cover cursor-zoom-in transition-transform group-hover:scale-105" onclick="openMediaLightbox(${idx}, event)" />`;
        } else if (type === 'video') {
          preview = `<div class="w-full h-40 bg-gradient-to-br from-[#f0eeeb] to-[#e5e2dd] flex flex-col items-center justify-center cursor-pointer hover:from-[#e5e2dd] hover:to-[#d4c4b0] transition-all" onclick="openMediaLightbox(${idx}, event)">
            <span class="text-3xl">🎬</span>
            <span class="text-xs text-[#6b6864] mt-1">点击预览</span>
          </div>`;
        } else if (type === 'audio') {
          preview = `<div class="w-full h-40 bg-gradient-to-br from-[#f0eeeb] to-[#e5e2dd] flex flex-col items-center justify-center">
            <span class="text-3xl">🎵</span>
            <span class="text-xs text-[#6b6864] mt-1">音频文件</span>
          </div>`;
        } else {
          preview = `<div class="w-full h-40 bg-[#f0eeeb] flex items-center justify-center text-3xl">📄</div>`;
        }

        const sizeKB = file.metadata?.size ? (file.metadata.size / 1024).toFixed(1) : '?';
        const unit = sizeKB === '?' ? 'KB' : (parseFloat(sizeKB as string) > 1024 ? (parseFloat(sizeKB as string) / 1024).toFixed(1) + ' MB' : sizeKB + ' KB');

        return `
          <div class="bg-white border border-[#e5e2dd] rounded-lg overflow-hidden group hover:shadow-md hover:border-[#d4c4b0] transition-all">
            <div class="relative overflow-hidden">${preview}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
            </div>
            <div class="p-3">
              <p class="text-xs text-[#2c2a28] truncate font-medium" title="${file.name}">${file.name.split('/').pop()}</p>
              <p class="text-xs text-[#9a9690] mt-1">${unit}</p>
              <div class="flex gap-2 mt-3">
                <button 
                  onclick="copyUrl('${url}')"
                  class="flex-1 text-xs py-1.5 bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded transition-colors"
                >复制链接</button>
                <button 
                  onclick="deleteFile('${file.name}')"
                  class="flex-1 text-xs py-1.5 bg-red-50 hover:bg-red-100 text-red-500 rounded transition-colors"
                >删除</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // 灯箱功能
    let currentLightboxIndex = 0;
    let currentFiles: any[] = [];

    (window as any).openMediaLightbox = function(idx: number, e: Event) {
      e.stopPropagation();
      // 重新计算当前筛选后的文件列表（仅图片+视频）
      currentFiles = allFiles.filter(f => {
        if (f.name === '.emptyFolderPlaceholder') return false;
        const type = getFileType(f.name);
        return type === 'image' || type === 'video';
      });

      // 找到在当前显示列表中的真实索引
      const displayFiles = allFiles
        .filter(f => f.name !== '.emptyFolderPlaceholder')
        .filter(f => currentFilter === 'all' || getFileType(f.name) === currentFilter)
        .filter(f => !searchQuery || f.name.toLowerCase().includes(searchQuery));

      const targetFile = displayFiles[idx];
      currentLightboxIndex = currentFiles.findIndex(f => f.name === targetFile.name);
      if (currentLightboxIndex < 0) currentLightboxIndex = 0;

      showLightboxItem();
      const lb = document.getElementById('media-lightbox');
      if (lb) {
        lb.classList.remove('hidden');
        lb.classList.add('flex');
      }
    };

    function showLightboxItem() {
      const file = currentFiles[currentLightboxIndex];
      if (!file) return;
      const url = getPublicUrl(file.name);
      const type = getFileType(file.name);
      const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
      const nameEl = document.getElementById('lightbox-name');

      if (type === 'image') {
        imgEl.style.display = 'block';
        imgEl.src = url;
        imgEl.alt = file.name;
      }
      if (nameEl) nameEl.textContent = file.name.split('/').pop();
    }

    (window as any).closeMediaLightbox = function() {
      const lb = document.getElementById('media-lightbox');
      if (lb) {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
      }
    };

    (window as any).downloadLightboxImage = function() {
      const file = currentFiles[currentLightboxIndex];
      if (!file) return;
      const url = getPublicUrl(file.name);
      const a = document.createElement('a');
      a.href = url;
      a.download = file.name.split('/').pop();
      a.target = '_blank';
      a.click();
    };

    // 灯箱左右切换
    document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentFiles.length === 0) return;
      currentLightboxIndex = (currentLightboxIndex - 1 + currentFiles.length) % currentFiles.length;
      showLightboxItem();
    });

    document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentFiles.length === 0) return;
      currentLightboxIndex = (currentLightboxIndex + 1) % currentFiles.length;
      showLightboxItem();
    });

    // 键盘操作
    document.addEventListener('keydown', (e) => {
      const lb = document.getElementById('media-lightbox');
      if (!lb || lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') (window as any).closeMediaLightbox();
      if (e.key === 'ArrowLeft') document.getElementById('lightbox-prev')?.click();
      if (e.key === 'ArrowRight') document.getElementById('lightbox-next')?.click();
    });

    // 上传图片
    document.getElementById('upload-image-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'image');
    });

    // 上传视频
    document.getElementById('upload-video-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'video');
    });

    // 上传音频
    document.getElementById('upload-audio-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'audio');
    });

    async function uploadMedia(files: FileList, type: string) {
      const statusEl = document.getElementById('upload-status');
      const progressEl = document.getElementById('upload-progress');
      if (statusEl) statusEl.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const timestamp = Date.now();
        const randomStr = Math.random().toString(36).substring(2, 8);
        const filePath = `${type}s/${timestamp}-${randomStr}-${file.name}`;

        try {
          if (progressEl) progressEl.textContent = `上传中 (${i + 1}/${files.length})`;

          const { error } = await supabase.storage
            .from('media')
            .upload(filePath, file, {
              cacheControl: '3600',
              upsert: false
            });

          if (error) throw error;
        } catch (err) {
          console.error('上传失败:', err);
          alert(`上传失败: ${err instanceof Error ? err.message : '未知错误'}`);
        }
      }

      if (statusEl) statusEl.classList.add('hidden');
      loadMedia();
    }

    async function loadMedia() {
      const gridEl = document.getElementById('media-grid');
      const countEl = document.getElementById('file-count');

      try {
        const { data, error } = await supabase.storage
          .from('media')
          .list('', { limit: 100, offset: 0, sortBy: { column: 'created_at', order: 'desc' } });

        if (error) throw error;

        allFiles = data || [];
        renderFiles();

      } catch (err) {
        console.error('加载媒体失败:', err);
        if (gridEl) {
          gridEl.innerHTML = `<div class="col-span-full text-center py-12 text-red-500">加载失败</div>`;
        }
      }
    }

    // 全局函数供 HTML 调用
    (window as any).copyUrl = function(url: string) {
      navigator.clipboard.writeText(url).then(() => {
        alert('链接已复制到剪贴板');
      });
    };

    (window as any).deleteFile = async function(name: string) {
      if (!confirm('确定要删除这个文件吗？')) return;

      try {
        const { error } = await supabase.storage
          .from('media')
          .remove([name]);

        if (error) throw error;
        loadMedia();
      } catch (err) {
        console.error('删除失败:', err);
        alert('删除失败');
      }
    };
  </script>
</Layout>
