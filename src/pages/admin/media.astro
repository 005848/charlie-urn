---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="媒体库 - 管理后台">
  <div class="min-h-screen bg-[#faf9f7]">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-medium text-[#2c2a28] mb-1">媒体库</h1>
          <p class="text-sm text-[#9a9690]">管理所有上传的图片、视频和音频文件</p>
        </div>
        <a href="/admin" class="text-sm text-[#6b6864] hover:text-[#b8977a] transition-colors">← 返回后台</a>
      </div>

      <!-- 上传区域 -->
      <div class="bg-white border border-[#e5e2dd] rounded-xl p-8 mb-8 text-center">
        <div class="text-4xl mb-4">📁</div>
        <p class="text-[#6b6864] mb-4">拖拽文件到此处，或点击下方按钮上传</p>
        <div class="flex items-center justify-center gap-3">
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🖼️ 上传图片
            <input type="file" accept="image/*" multiple class="hidden" id="upload-image-btn" />
          </label>
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🎬 上传视频
            <input type="file" accept="video/*" class="hidden" id="upload-video-btn" />
          </label>
          <label class="cursor-pointer px-4 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm">
            🎵 上传音频
            <input type="file" accept="audio/*" class="hidden" id="upload-audio-btn" />
          </label>
        </div>
        <div id="upload-status" class="mt-4 text-sm text-[#9a9690] hidden">
          正在上传... <span id="upload-progress">0%</span>
        </div>
      </div>

      <!-- 文件列表 -->
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-medium text-[#2c2a28]">全部文件</h2>
        <span id="file-count" class="text-sm text-[#9a9690]">加载中...</span>
      </div>

      <div id="media-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="col-span-full text-center py-12 text-[#9a9690]">
          加载中...
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getSupabase, uploadFile, listMediaFiles, deleteMediaFile, getFileType, getPublicUrl } from '../../lib/supabase/client';

    const supabase = getSupabase();

    // 鉴权检查
    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
        return false;
      }
      return true;
    }

    checkAuth().then(isAdmin => {
      if (isAdmin) loadMedia();
    });

    // 上传图片
    document.getElementById('upload-image-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'image');
    });

    // 上传视频
    document.getElementById('upload-video-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'video');
    });

    // 上传音频
    document.getElementById('upload-audio-btn')?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) uploadMedia(files, 'audio');
    });

    async function uploadMedia(files: FileList, type: string) {
      const statusEl = document.getElementById('upload-status');
      const progressEl = document.getElementById('upload-progress');
      if (statusEl) statusEl.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const timestamp = Date.now();
        const randomStr = Math.random().toString(36).substring(2, 8);
        const filePath = `${type}s/${timestamp}-${randomStr}-${file.name}`;

        try {
          if (progressEl) progressEl.textContent = `上传中 (${i + 1}/${files.length})`;

          const { error } = await supabase.storage
            .from('media')
            .upload(filePath, file, {
              cacheControl: '3600',
              upsert: false
            });

          if (error) throw error;
        } catch (err) {
          console.error('上传失败:', err);
          alert(`上传失败: ${err instanceof Error ? err.message : '未知错误'}`);
        }
      }

      if (statusEl) statusEl.classList.add('hidden');
      loadMedia();
    }

    async function loadMedia() {
      const gridEl = document.getElementById('media-grid');
      const countEl = document.getElementById('file-count');

      try {
        const { data, error } = await supabase.storage
          .from('media')
          .list('', { limit: 100, offset: 0, sortBy: { column: 'created_at', order: 'desc' } });

        if (error) throw error;

        const files = data?.filter(f => f.name !== '.emptyFolderPlaceholder') || [];

        if (countEl) countEl.textContent = `共 ${files.length} 个文件`;

        if (!gridEl) return;

        if (files.length === 0) {
          gridEl.innerHTML = `
            <div class="col-span-full text-center py-12 text-[#9a9690]">
              还没有上传任何文件
            </div>
          `;
          return;
        }

        gridEl.innerHTML = files.map(file => {
          const url = getPublicUrl(file.name);
          const isImage = /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(file.name);
          const isVideo = /\.(mp4|webm|ogg|mov)$/i.test(file.name);
          const isAudio = /\.(mp3|wav|ogg|m4a|webm)$/i.test(file.name);

          let preview = '';
          let icon = '📁';
          if (isImage) {
            preview = `<img src="${url}" alt="${file.name}" class="w-full h-32 object-cover" />`;
            icon = '🖼️';
          } else if (isVideo) {
            preview = `<div class="w-full h-32 bg-[#f0eeeb] flex items-center justify-center text-3xl">🎬</div>`;
            icon = '🎬';
          } else if (isAudio) {
            preview = `<div class="w-full h-32 bg-[#f0eeeb] flex items-center justify-center text-3xl">🎵</div>`;
            icon = '🎵';
          } else {
            preview = `<div class="w-full h-32 bg-[#f0eeeb] flex items-center justify-center text-3xl">📄</div>`;
          }

          const sizeKB = (file.metadata?.size / 1024).toFixed(1);

          return `
            <div class="bg-white border border-[#e5e2dd] rounded-lg overflow-hidden group">
              ${preview}
              <div class="p-3">
                <p class="text-xs text-[#2c2a28] truncate" title="${file.name}">${file.name}</p>
                <p class="text-xs text-[#9a9690] mt-1">${sizeKB} KB</p>
                <div class="flex gap-2 mt-2">
                  <button 
                    onclick="copyUrl('${url}')"
                    class="flex-1 text-xs py-1 bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded transition-colors"
                  >复制链接</button>
                  <button 
                    onclick="deleteFile('${file.name}')"
                    class="flex-1 text-xs py-1 bg-red-50 hover:bg-red-100 text-red-500 rounded transition-colors"
                  >删除</button>
                </div>
              </div>
            </div>
          `;
        }).join('');

      } catch (err) {
        console.error('加载媒体失败:', err);
        if (gridEl) {
          gridEl.innerHTML = `<div class="col-span-full text-center py-12 text-red-500">加载失败</div>`;
        }
      }
    }

    // 全局函数供 HTML 调用
    (window as any).copyUrl = function(url: string) {
      navigator.clipboard.writeText(url).then(() => {
        alert('链接已复制到剪贴板');
      });
    };

    (window as any).deleteFile = async function(name: string) {
      if (!confirm('确定要删除这个文件吗？')) return;

      try {
        const { error } = await supabase.storage
          .from('media')
          .remove([name]);

        if (error) throw error;
        loadMedia();
      } catch (err) {
        console.error('删除失败:', err);
        alert('删除失败');
      }
    };
  </script>
</Layout>
