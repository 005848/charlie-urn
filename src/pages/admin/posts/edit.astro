---
import Layout from '../../../layouts/Layout.astro';
import { CATEGORIES } from '../../../consts';
---

<Layout title="编辑文章 - Charlie的电子骨灰盒" description="文章编辑后台">
  <div class="min-h-screen bg-[#faf9f7] py-12">
    <div class="max-w-3xl mx-auto px-4">
      <div class="mb-8">
        <a href="/admin/posts" class="text-[#6b6864] hover:text-[#b8977a] transition-colors text-sm flex items-center gap-1">
          <span>←</span> 返回文章列表
        </a>
        <h1 id="page-title" class="mt-4 text-2xl font-serif text-[#2c2a28]">编辑文章</h1>
      </div>

      <form id="post-form" class="space-y-6">
        <div>
          <label for="title" class="block text-sm text-[#6b6864] mb-2">标题</label>
          <input
            type="text"
            id="title"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            placeholder="输入文章标题"
          />
        </div>

        <div>
          <label for="slug" class="block text-sm text-[#6b6864] mb-2">Slug (URL 标识)</label>
          <input
            type="text"
            id="slug"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] font-mono text-sm"
            placeholder="my-post-slug"
          />
        </div>

        <!-- 封面图 -->
        <div>
          <label class="block text-sm text-[#6b6864] mb-2">封面图</label>
          <input type="hidden" id="cover_image" name="cover_image" value="" />
          <div id="cover-image-container" class="hidden mb-3">
            <img id="cover-preview" class="w-full h-48 object-cover rounded-lg border border-[#e5e2dd]" />
            <button type="button" id="remove-cover" class="mt-2 text-xs text-[#6b6864] hover:text-[#b8977a]">移除封面图</button>
          </div>
          <label class="cursor-pointer inline-block px-4 py-2 bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors text-sm">
            📷 上传封面图
            <input type="file" accept="image/*" class="hidden" id="cover-upload" />
          </label>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="category" class="block text-sm text-[#6b6864] mb-2">分类</label>
            <select
              id="category"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            >
              <option value="">加载中...</option>
            </select>
          </div>
          <div>
            <label for="pubDate" class="block text-sm text-[#6b6864] mb-2">发布日期</label>
            <input
              type="date"
              id="pubDate"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            />
          </div>
        </div>

        <div>
          <label for="tags" class="block text-sm text-[#6b6864] mb-2">标签（用逗号分隔）</label>
          <input
            type="text"
            id="tags"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            placeholder="标签1, 标签2, 标签3"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="weather" class="block text-sm text-[#6b6864] mb-2">天气</label>
            <input
              type="text"
              id="weather"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
              placeholder="晴 / 雨 / 多云..."
            />
          </div>
          <div>
            <label for="mood" class="block text-sm text-[#6b6864] mb-2">心情</label>
            <input
              type="text"
              id="mood"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
              placeholder="平静 / 思念 / 温暖..."
            />
          </div>
        </div>

        <div>
          <label for="unlock_date" class="block text-sm text-[#6b6864] mb-2">时间胶囊 · 解锁日期（可选）</label>
          <input
            type="date"
            id="unlock_date"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
          />
          <p class="text-xs text-[#9a9690] mt-1">设置后，文章将在指定日期之前对访客隐藏</p>
        </div>

        <div>
          <label for="description" class="block text-sm text-[#6b6864] mb-2">摘要</label>
          <textarea
            id="description"
            rows="2"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] resize-none"
            placeholder="文章简短描述"
          ></textarea>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="content" class="block text-sm text-[#6b6864]">正文 (Markdown)</label>
            <div class="flex gap-2">
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🖼️</span> 插入图片
                <input type="file" accept="image/*" class="hidden" id="upload-image" multiple />
              </label>
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🎬</span> 插入视频
                <input type="file" accept="video/*" class="hidden" id="upload-video" />
              </label>
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🎵</span> 插入音频
                <input type="file" accept="audio/*" class="hidden" id="upload-audio" />
              </label>
              <button type="button" id="insert-code-btn" class="px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>💻</span> 插入代码
              </button>
            </div>
          </div>
          <textarea
            id="content"
            rows="20"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] font-mono text-sm resize-y"
            placeholder="# 标题

正文内容..."
          ></textarea>
          <div id="upload-status" class="mt-2 text-xs text-[#9a9690] hidden">
            正在上传... <span id="upload-progress">0%</span>
          </div>
        </div>

        <!-- 实时预览 -->
        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <label class="text-sm text-[#6b6864]">实时预览</label>
            <span class="text-xs text-[#9a9690]">Markdown 渲染</span>
          </div>
          <div
            id="preview"
            class="prose-content min-h-[200px] p-4 bg-[#faf9f7] border border-[#e5e2dd] rounded-lg text-[#2c2a28] text-sm"
          >
            <p class="text-[#9a9690]">预览将显示在这里...</p>
          </div>
        </div>

        <div>
          <label for="status" class="block text-sm text-[#6b6864] mb-2">状态</label>
          <select
            id="status"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
          >
            <option value="published">已发布</option>
            <option value="draft">草稿</option>
          </select>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#e5e2dd]">
          <button
            type="button"
            id="delete-btn"
            class="hidden px-6 py-2 text-sm text-red-500 hover:text-red-700 transition-colors"
          >
            删除文章
          </button>
          <div class="flex gap-3 ml-auto">
            <button
              type="button"
              onclick="history.back()"
              class="px-6 py-2 text-sm text-[#6b6864] hover:text-[#2c2a28] transition-colors"
            >
              取消
            </button>
            <button
              type="submit"
              id="submit-btn"
              class="px-6 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm"
            >
              保存
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { createClient, SupabaseClient } from '@supabase/supabase-js';

    let supabase: SupabaseClient | null = null;
    function getSupabase() {
      if (supabase) return supabase;
      const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
      const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
      if (!url || !anonKey) return null;
      supabase = createClient(url, anonKey);
      return supabase;
    }

    // 检查登录状态
    (async () => {
      const sb = getSupabase();
      if (!sb) return;
      const { data } = await sb.auth.getSession();
      if (!data?.session) {
        window.location.href = '/admin/login';
      }
    })();

    // 获取 URL 中的 id 参数
    const params = new URLSearchParams(window.location.search);
    const postId = params.get('id');
    const pageTitle = document.getElementById('page-title') as HTMLElement;
    const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;

    const form = document.getElementById('post-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (!postId) {
      pageTitle.textContent = '新建文章';
      const dateInput = document.getElementById('pubDate') as HTMLInputElement;
      dateInput.value = new Date().toISOString().split('T')[0];
    } else {
      pageTitle.textContent = '编辑文章';
      deleteBtn.classList.remove('hidden');
      loadPost(postId);
    }

    async function loadPost(id: string) {
      const sb = getSupabase();
      if (!sb) return;

      try {
        const { data: post, error } = await sb
          .from('blog_posts')
          .select('*')
          .eq('id', id)
          .single();

        if (error) throw error;
        if (!post) throw new Error('文章不存在');

        (document.getElementById('title') as HTMLInputElement).value = post.title || '';
        (document.getElementById('slug') as HTMLInputElement).value = post.slug || '';
        (document.getElementById('category') as HTMLSelectElement).value = post.category || 'essay';
        (document.getElementById('description') as HTMLTextAreaElement).value = post.description || '';
        (document.getElementById('content') as HTMLTextAreaElement).value = post.content || '';
        (document.getElementById('status') as HTMLSelectElement).value = post.status || 'draft';
        (document.getElementById('tags') as HTMLInputElement).value = (post.tags || []).join(', ');
        if (post.pub_date) {
          (document.getElementById('pubDate') as HTMLInputElement).value = post.pub_date.split('T')[0];
        }
        updatePreview();
      } catch (err) {
        alert('加载文章失败：' + (err as any).message);
        console.error(err);
      }
    }

    // 实时预览
    const contentTextarea = document.getElementById('content') as HTMLTextAreaElement;
    function updatePreview() {
      const preview = document.getElementById('preview') as HTMLDivElement;
      const content = contentTextarea.value;
      // 简单的 Markdown 渲染（支持基础语法）
      let html = content
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/!\[(.*?)\]\((.*?)\)/g, '<img alt="$1" src="$2" style="max-width:100%;border-radius:8px;">')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>')
        .replace(/^- (.*$)/gim, '<li>$1</li>')
        .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
        .replace(/^(\d+)\. (.*$)/gim, '<li>$2</li>')
        .replace(/\n/g, '<br>');
      preview.innerHTML = html;
    }
    contentTextarea.addEventListener('input', updatePreview);
    updatePreview();

    // --- 上传文件到 Supabase Storage ---
    async function uploadFile(file: File, folder: string = 'blog-images'): Promise<string | null> {
      const sb = getSupabase();
      if (!sb) {
        alert('Supabase 未配置');
        return null;
      }

      const fileExt = file.name.split('.').pop();
      const fileName = `${folder}/${Date.now()}-${Math.random().toString(36).substring(2, 10)}.${fileExt}`;

      const { error, data } = await sb.storage
        .from('media')
        .upload(fileName, file, {
          cacheControl: '3600',
          upsert: false,
        });

      if (error) {
        console.error('上传失败:', error);
        alert('上传失败: ' + error.message);
        return null;
      }

      const { data: urlData } = sb.storage.from('media').getPublicUrl(fileName);
      return urlData?.publicUrl || null;
    }

    // --- 加载分类列表 ---
    async function loadCategories() {
      const sb = getSupabase();
      if (!sb) return;

      try {
        const { data: categories, error } = await sb
          .from('categories')
          .select('*')
          .order('sort_order', { ascending: true });

        if (error) throw error;

        const select = document.getElementById('category') as HTMLSelectElement;
        if (!select) return;

        // 保留默认选项
        select.innerHTML = '<option value="">请选择分类</option>';

        categories?.forEach((cat: any) => {
          const option = document.createElement('option');
          option.value = cat.slug;
          option.textContent = cat.name;
          select.appendChild(option);
        });
      } catch (err) {
        console.error('加载分类失败:', err);
      }
    }
    loadCategories();

    // --- 封面图上传 ---
    const coverInput = document.getElementById('cover-upload') as HTMLInputElement;
    const coverPreview = document.getElementById('cover-preview') as HTMLImageElement;
    const coverUrlInput = document.getElementById('cover_image') as HTMLInputElement;

    coverInput?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      // 先显示本地预览
      const reader = new FileReader();
      reader.onload = (ev) => {
        if (coverPreview && ev.target?.result) {
          coverPreview.src = ev.target.result as string;
          coverPreview.style.display = 'block';
        }
      };
      reader.readAsDataURL(file);

      // 上传到服务器
      const uploadStatus = document.getElementById('upload-status') as HTMLDivElement;
      if (uploadStatus) {
        uploadStatus.textContent = '封面图上传中...';
        uploadStatus.classList.remove('hidden');
      }

      const publicUrl = await uploadFile(file, 'covers');
      if (publicUrl && coverUrlInput) {
        coverUrlInput.value = publicUrl;
        if (uploadStatus) uploadStatus.textContent = '封面图上传成功 ✓';
      } else {
        if (uploadStatus) uploadStatus.textContent = '封面图上传失败';
      }

      setTimeout(() => {
        uploadStatus?.classList.add('hidden');
      }, 2000);
    });

    // --- 移除封面图 ---
    const removeCoverBtn = document.getElementById('remove-cover') as HTMLButtonElement;
    const coverImageContainer = document.getElementById('cover-image-container') as HTMLDivElement;
    removeCoverBtn?.addEventListener('click', () => {
      if (coverPreview) {
        coverPreview.src = '';
        coverPreview.style.display = 'none';
      }
      if (coverImageContainer) coverImageContainer.classList.add('hidden');
      if (coverUrlInput) coverUrlInput.value = '';
      if (coverInput) coverInput.value = '';
    });

    // --- 媒体上传功能 ---
    const uploadStatus = document.getElementById('upload-status') as HTMLDivElement;
    const uploadProgress = document.getElementById('upload-progress') as HTMLSpanElement;

    function insertAtCursor(textarea: HTMLTextAreaElement, text: string) {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const value = textarea.value;
      textarea.value = value.substring(0, start) + text + value.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + text.length;
      textarea.focus();
      updatePreview();
    }

    async function handleMediaUpload(files: FileList | null, type: 'image' | 'video' | 'audio') {
      if (!files || files.length === 0) return;

      const sb = getSupabase();
      if (!sb) {
        alert('请先登录');
        return;
      }

      uploadStatus.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const timestamp = Date.now();
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
        const path = `${type}s/${timestamp}-${safeName}`;

        try {
          uploadProgress.textContent = `${Math.round((i / files.length) * 100)}%`;

          const { error } = await sb.storage
            .from('media')
            .upload(path, file, {
              cacheControl: '3600',
              upsert: false,
            });

          if (error) throw error;

          // 获取公开 URL
          const { data: urlData } = sb.storage.from('media').getPublicUrl(path);
          const url = urlData.publicUrl;

          // 插入到编辑器
          let markdown = '';
          if (type === 'image') {
            markdown = `\n![${file.name}](${url})\n`;
          } else if (type === 'video') {
            markdown = `\n<video controls src="${url}" style="max-width:100%;border-radius:8px;margin:1em 0;"></video>\n`;
          } else if (type === 'audio') {
            markdown = `\n<audio controls src="${url}" style="width:100%;margin:1em 0;"></audio>\n`;
          }

          insertAtCursor(contentTextarea, markdown);

        } catch (err) {
          alert(`上传失败：${(err as any).message || err}`);
          console.error(err);
        }
      }

      uploadProgress.textContent = '100%';
      setTimeout(() => {
        uploadStatus.classList.add('hidden');
        uploadProgress.textContent = '0%';
      }, 1500);
    }

    (document.getElementById('upload-image') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'image');
      (e.target as HTMLInputElement).value = '';
    });

    (document.getElementById('upload-video') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'video');
      (e.target as HTMLInputElement).value = '';
    });

    (document.getElementById('upload-audio') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'audio');
      (e.target as HTMLInputElement).value = '';
    });

    // 插入代码块
    document.getElementById('insert-code-btn')?.addEventListener('click', () => {
      const textarea = document.getElementById('content') as HTMLTextAreaElement;
      const lang = prompt('请输入代码语言（如 javascript、python、html、css、sql 等，留空则无语法高亮）：', 'javascript') || '';
      const code = prompt('粘贴你的代码：', '') || '';
      if (!code) return;
      const codeBlock = `\n\`\`\`${lang}\n${code}\n\`\`\`\n`;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      textarea.value = textarea.value.substring(0, start) + codeBlock + textarea.value.substring(end);
      textarea.dispatchEvent(new Event('input'));
      const newPos = start + codeBlock.length;
      textarea.focus();
      textarea.setSelectionRange(newPos, newPos);
    });

    // --- Markdown 工具栏 ---
    const toolbar = document.getElementById('md-toolbar');
    const textarea = document.getElementById('content') as HTMLTextAreaElement;

    function insertMarkdown(prefix: string, suffix = '', placeholder = '') {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selected = textarea.value.substring(start, end) || placeholder;
      const before = textarea.value.substring(0, start);
      const after = textarea.value.substring(end, textarea.value.length);
      textarea.value = before + prefix + selected + suffix + after;
      textarea.focus();
      textarea.selectionStart = start + prefix.length;
      textarea.selectionEnd = start + prefix.length + selected.length;
    }

    const toolbarBtns: Record<string, () => void> = {
      'bold': () => insertMarkdown('**', '**', '粗体文字'),
      'italic': () => insertMarkdown('*', '*', '斜体文字'),
      'h2': () => insertMarkdown('\n## ', '\n', '二级标题'),
      'h3': () => insertMarkdown('\n### ', '\n', '三级标题'),
      'link': () => insertMarkdown('[', '](https://)', '链接文字'),
      'quote': () => insertMarkdown('\n> ', '\n', '引用内容'),
      'code': () => insertMarkdown('\n```javascript\n', '\n```\n', '// 代码'),
      'list': () => insertMarkdown('\n- ', '\n', '列表项'),
      'hr': () => insertMarkdown('\n\n---\n\n', '', ''),
    };

    if (toolbar) {
      toolbar.querySelectorAll('button[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = (btn as HTMLButtonElement).dataset.action;
          if (action && toolbarBtns[action]) {
            toolbarBtns[action]();
            // 触发预览更新
            textarea.dispatchEvent(new Event('input'));
          }
        });
      });
    }

    // --- 草稿自动保存 ---
    const DRAFT_KEY = 'charlie_post_draft';
    let autoSaveTimer: number | null = null;
    const draftStatus = document.getElementById('draft-status');

    function saveDraft() {
      const title = (document.getElementById('title') as HTMLInputElement).value;
      const content = textarea.value;
      if (!title && !content) return;
      const draft = {
        title,
        slug: (document.getElementById('slug') as HTMLInputElement).value,
        category: (document.getElementById('category') as HTMLSelectElement).value,
        description: (document.getElementById('description') as HTMLTextAreaElement).value,
        content,
        tags: (document.getElementById('tags') as HTMLInputElement).value,
        savedAt: new Date().toISOString(),
      };
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      if (draftStatus) {
        draftStatus.textContent = '草稿已自动保存 · ' + new Date().toLocaleTimeString('zh-CN');
        setTimeout(() => { if (draftStatus) draftStatus.textContent = ''; }, 3000);
      }
    }

    function restoreDraft() {
      const saved = localStorage.getItem(DRAFT_KEY);
      if (!saved) return;
      if (postId) return; // 编辑模式不恢复草稿
      try {
        const draft = JSON.parse(saved);
        if (confirm('发现未完成的草稿，是否恢复？')) {
          (document.getElementById('title') as HTMLInputElement).value = draft.title || '';
          (document.getElementById('slug') as HTMLInputElement).value = draft.slug || '';
          (document.getElementById('description') as HTMLTextAreaElement).value = draft.description || '';
          textarea.value = draft.content || '';
          (document.getElementById('tags') as HTMLInputElement).value = draft.tags || '';
          if (draft.category) {
            const catSelect = document.getElementById('category') as HTMLSelectElement;
            setTimeout(() => { catSelect.value = draft.category; }, 300);
          }
          textarea.dispatchEvent(new Event('input'));
        }
      } catch(e) { console.warn('草稿恢复失败', e); }
    }

    textarea.addEventListener('input', () => {
      if (autoSaveTimer) clearTimeout(autoSaveTimer);
      autoSaveTimer = window.setTimeout(saveDraft, 3000);
    });
    document.getElementById('title')?.addEventListener('input', () => {
      if (autoSaveTimer) clearTimeout(autoSaveTimer);
      autoSaveTimer = window.setTimeout(saveDraft, 3000);
    });
    restoreDraft();

    // 保存成功后清除草稿
    function clearDraft() {
      localStorage.removeItem(DRAFT_KEY);
    }

    // --- 表单提交 ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const sb = getSupabase();
      if (!sb) return;

      submitBtn.disabled = true;
      submitBtn.textContent = '保存中...';

      const title = (document.getElementById('title') as HTMLInputElement).value;
      const slug = (document.getElementById('slug') as HTMLInputElement).value;
      const category = (document.getElementById('category') as HTMLSelectElement).value;
      const description = (document.getElementById('description') as HTMLTextAreaElement).value;
      const content = (document.getElementById('content') as HTMLTextAreaElement).value;
      const status = (document.getElementById('status') as HTMLSelectElement).value;
      const tagsStr = (document.getElementById('tags') as HTMLInputElement).value;
      const tags = tagsStr.split(',').map((t) => t.trim()).filter(Boolean);
      const pub_date = (document.getElementById('pubDate') as HTMLInputElement).value;
      const cover_image = (document.getElementById('cover_image') as HTMLInputElement).value;
      const weather = (document.getElementById('weather') as HTMLInputElement).value || null;
      const mood = (document.getElementById('mood') as HTMLInputElement).value || null;
      const unlock_date = (document.getElementById('unlock_date') as HTMLInputElement).value || null;

      const postData: any = { title, slug, category, description, content, status, tags, pub_date };
      if (cover_image) postData.cover_image = cover_image;
      if (weather) postData.weather = weather;
      if (mood) postData.mood = mood;
      if (unlock_date) postData.unlock_date = unlock_date;

      try {
        if (postId) {
          // 更新
          postData.updated_at = new Date().toISOString();
          const { error } = await sb
            .from('blog_posts')
            .update(postData)
            .eq('id', postId);
          if (error) throw error;
        } else {
          // 新建
          const { error } = await sb
            .from('blog_posts')
            .insert(postData);
          if (error) throw error;
        }

        alert('保存成功');
        clearDraft();
        window.location.href = '/admin/posts';
      } catch (err) {
        alert('保存失败：' + (err as any).message);
        submitBtn.disabled = false;
        submitBtn.textContent = '保存';
      }
    });

    // 删除按钮
    deleteBtn.addEventListener('click', async () => {
      if (!postId) return;
      if (!confirm('确定要删除这篇文章吗？此操作不可撤销。')) return;

      const sb = getSupabase();
      if (!sb) return;

      try {
        const { error } = await sb
          .from('blog_posts')
          .delete()
          .eq('id', postId);
        if (error) throw error;

        alert('删除成功');
        window.location.href = '/admin/posts';
      } catch (err) {
        alert('删除失败：' + (err as any).message);
      }
    });
  </script>
</Layout>
