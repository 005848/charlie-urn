---
import Layout from '../../../layouts/Layout.astro';
import { CATEGORIES } from '../../../consts';
---

<Layout title="编辑文章 - Charlie的电子骨灰盒" description="文章编辑后台">
  <div class="min-h-screen bg-[#faf9f7] py-12">
    <div class="max-w-3xl mx-auto px-4">
      <div class="mb-8">
        <a href="/admin/posts" class="text-[#6b6864] hover:text-[#b8977a] transition-colors text-sm flex items-center gap-1">
          <span>←</span> 返回文章列表
        </a>
        <h1 id="page-title" class="mt-4 text-2xl font-serif text-[#2c2a28]">编辑文章</h1>
      </div>

      <form id="post-form" class="space-y-6">
        <div>
          <label for="title" class="block text-sm text-[#6b6864] mb-2">标题</label>
          <input
            type="text"
            id="title"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            placeholder="输入文章标题"
          />
        </div>

        <div>
          <label for="slug" class="block text-sm text-[#6b6864] mb-2">Slug (URL 标识)</label>
          <input
            type="text"
            id="slug"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] font-mono text-sm"
            placeholder="my-post-slug"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="category" class="block text-sm text-[#6b6864] mb-2">分类</label>
            <select
              id="category"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            >
              {CATEGORIES.map((cat) => (
                <option value={cat.value}>{cat.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="pubDate" class="block text-sm text-[#6b6864] mb-2">发布日期</label>
            <input
              type="date"
              id="pubDate"
              class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            />
          </div>
        </div>

        <div>
          <label for="tags" class="block text-sm text-[#6b6864] mb-2">标签（用逗号分隔）</label>
          <input
            type="text"
            id="tags"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
            placeholder="标签1, 标签2, 标签3"
          />
        </div>

        <div>
          <label for="description" class="block text-sm text-[#6b6864] mb-2">摘要</label>
          <textarea
            id="description"
            rows="2"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] resize-none"
            placeholder="文章简短描述"
          ></textarea>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="content" class="block text-sm text-[#6b6864]">正文 (Markdown)</label>
            <div class="flex gap-2">
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🖼️</span> 插入图片
                <input type="file" accept="image/*" class="hidden" id="upload-image" multiple />
              </label>
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🎬</span> 插入视频
                <input type="file" accept="video/*" class="hidden" id="upload-video" />
              </label>
              <label class="cursor-pointer px-3 py-1.5 text-xs bg-[#f0eeeb] hover:bg-[#e5e2dd] text-[#6b6864] rounded-md transition-colors flex items-center gap-1">
                <span>🎵</span> 插入音频
                <input type="file" accept="audio/*" class="hidden" id="upload-audio" />
              </label>
            </div>
          </div>
          <textarea
            id="content"
            rows="20"
            required
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28] font-mono text-sm resize-y"
            placeholder="# 标题

正文内容..."
          ></textarea>
          <div id="upload-status" class="mt-2 text-xs text-[#9a9690] hidden">
            正在上传... <span id="upload-progress">0%</span>
          </div>
        </div>

        <div>
          <label for="status" class="block text-sm text-[#6b6864] mb-2">状态</label>
          <select
            id="status"
            class="w-full px-4 py-3 bg-white border border-[#e5e2dd] rounded-lg focus:outline-none focus:border-[#b8977a] transition-colors text-[#2c2a28]"
          >
            <option value="published">已发布</option>
            <option value="draft">草稿</option>
          </select>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#e5e2dd]">
          <button
            type="button"
            id="delete-btn"
            class="hidden px-6 py-2 text-sm text-red-500 hover:text-red-700 transition-colors"
          >
            删除文章
          </button>
          <div class="flex gap-3 ml-auto">
            <button
              type="button"
              onclick="history.back()"
              class="px-6 py-2 text-sm text-[#6b6864] hover:text-[#2c2a28] transition-colors"
            >
              取消
            </button>
            <button
              type="submit"
              id="submit-btn"
              class="px-6 py-2 bg-[#b8977a] text-white rounded-lg hover:bg-[#8c7159] transition-colors text-sm"
            >
              保存
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { createClient, SupabaseClient } from '@supabase/supabase-js';

    let supabase: SupabaseClient | null = null;
    function getSupabase() {
      if (supabase) return supabase;
      const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
      const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
      if (!url || !anonKey) return null;
      supabase = createClient(url, anonKey);
      return supabase;
    }

    // 检查登录状态
    (async () => {
      const sb = getSupabase();
      if (!sb) return;
      const { data } = await sb.auth.getSession();
      if (!data?.session) {
        window.location.href = '/admin/login';
      }
    })();

    // 获取 URL 中的 id 参数
    const params = new URLSearchParams(window.location.search);
    const postId = params.get('id');
    const pageTitle = document.getElementById('page-title') as HTMLElement;
    const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;

    const form = document.getElementById('post-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (!postId) {
      pageTitle.textContent = '新建文章';
      const dateInput = document.getElementById('pubDate') as HTMLInputElement;
      dateInput.value = new Date().toISOString().split('T')[0];
    } else {
      pageTitle.textContent = '编辑文章';
      deleteBtn.classList.remove('hidden');
      loadPost(postId);
    }

    async function loadPost(id: string) {
      const sb = getSupabase();
      if (!sb) return;

      try {
        const { data: post, error } = await sb
          .from('blog_posts')
          .select('*')
          .eq('id', id)
          .single();

        if (error) throw error;
        if (!post) throw new Error('文章不存在');

        (document.getElementById('title') as HTMLInputElement).value = post.title || '';
        (document.getElementById('slug') as HTMLInputElement).value = post.slug || '';
        (document.getElementById('category') as HTMLSelectElement).value = post.category || 'essay';
        (document.getElementById('description') as HTMLTextAreaElement).value = post.description || '';
        (document.getElementById('content') as HTMLTextAreaElement).value = post.content || '';
        (document.getElementById('status') as HTMLSelectElement).value = post.status || 'draft';
        (document.getElementById('tags') as HTMLInputElement).value = (post.tags || []).join(', ');
        if (post.pub_date) {
          (document.getElementById('pubDate') as HTMLInputElement).value = post.pub_date.split('T')[0];
        }
        updatePreview();
      } catch (err) {
        alert('加载文章失败：' + (err as any).message);
        console.error(err);
      }
    }

    // 实时预览
    const contentTextarea = document.getElementById('content') as HTMLTextAreaElement;
    function updatePreview() {
      const preview = document.getElementById('preview') as HTMLDivElement;
      const content = contentTextarea.value;
      // 简单的 Markdown 渲染（支持基础语法）
      let html = content
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/!\[(.*?)\]\((.*?)\)/g, '<img alt="$1" src="$2" style="max-width:100%;border-radius:8px;">')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>')
        .replace(/^- (.*$)/gim, '<li>$1</li>')
        .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
        .replace(/^(\d+)\. (.*$)/gim, '<li>$2</li>')
        .replace(/\n/g, '<br>');
      preview.innerHTML = html;
    }
    contentTextarea.addEventListener('input', updatePreview);
    updatePreview();

    // --- 媒体上传功能 ---
    const uploadStatus = document.getElementById('upload-status') as HTMLDivElement;
    const uploadProgress = document.getElementById('upload-progress') as HTMLSpanElement;

    function insertAtCursor(textarea: HTMLTextAreaElement, text: string) {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const value = textarea.value;
      textarea.value = value.substring(0, start) + text + value.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + text.length;
      textarea.focus();
      updatePreview();
    }

    async function handleMediaUpload(files: FileList | null, type: 'image' | 'video' | 'audio') {
      if (!files || files.length === 0) return;

      const sb = getSupabase();
      if (!sb) {
        alert('请先登录');
        return;
      }

      uploadStatus.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const timestamp = Date.now();
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
        const path = `${type}s/${timestamp}-${safeName}`;

        try {
          uploadProgress.textContent = `${Math.round((i / files.length) * 100)}%`;

          const { error } = await sb.storage
            .from('media')
            .upload(path, file, {
              cacheControl: '3600',
              upsert: false,
            });

          if (error) throw error;

          // 获取公开 URL
          const { data: urlData } = sb.storage.from('media').getPublicUrl(path);
          const url = urlData.publicUrl;

          // 插入到编辑器
          let markdown = '';
          if (type === 'image') {
            markdown = `\n![${file.name}](${url})\n`;
          } else if (type === 'video') {
            markdown = `\n<video controls src="${url}" style="max-width:100%;border-radius:8px;margin:1em 0;"></video>\n`;
          } else if (type === 'audio') {
            markdown = `\n<audio controls src="${url}" style="width:100%;margin:1em 0;"></audio>\n`;
          }

          insertAtCursor(contentTextarea, markdown);

        } catch (err) {
          alert(`上传失败：${(err as any).message || err}`);
          console.error(err);
        }
      }

      uploadProgress.textContent = '100%';
      setTimeout(() => {
        uploadStatus.classList.add('hidden');
        uploadProgress.textContent = '0%';
      }, 1500);
    }

    (document.getElementById('upload-image') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'image');
      (e.target as HTMLInputElement).value = '';
    });

    (document.getElementById('upload-video') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'video');
      (e.target as HTMLInputElement).value = '';
    });

    (document.getElementById('upload-audio') as HTMLInputElement).addEventListener('change', (e) => {
      handleMediaUpload((e.target as HTMLInputElement).files, 'audio');
      (e.target as HTMLInputElement).value = '';
    });

    // --- 表单提交 ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const sb = getSupabase();
      if (!sb) return;

      submitBtn.disabled = true;
      submitBtn.textContent = '保存中...';

      const title = (document.getElementById('title') as HTMLInputElement).value;
      const slug = (document.getElementById('slug') as HTMLInputElement).value;
      const category = (document.getElementById('category') as HTMLSelectElement).value;
      const description = (document.getElementById('description') as HTMLTextAreaElement).value;
      const content = (document.getElementById('content') as HTMLTextAreaElement).value;
      const status = (document.getElementById('status') as HTMLSelectElement).value;
      const tagsStr = (document.getElementById('tags') as HTMLInputElement).value;
      const tags = tagsStr.split(',').map((t) => t.trim()).filter(Boolean);
      const pub_date = (document.getElementById('pubDate') as HTMLInputElement).value;

      try {
        if (postId) {
          // 更新
          const { error } = await sb
            .from('blog_posts')
            .update({ title, slug, category, description, content, status, tags, pub_date, updated_at: new Date().toISOString() })
            .eq('id', postId);
          if (error) throw error;
        } else {
          // 新建
          const { error } = await sb
            .from('blog_posts')
            .insert({ title, slug, category, description, content, status, tags, pub_date });
          if (error) throw error;
        }

        alert('保存成功');
        window.location.href = '/admin/posts';
      } catch (err) {
        alert('保存失败：' + (err as any).message);
        submitBtn.disabled = false;
        submitBtn.textContent = '保存';
      }
    });

    // 删除按钮
    deleteBtn.addEventListener('click', async () => {
      if (!postId) return;
      if (!confirm('确定要删除这篇文章吗？此操作不可撤销。')) return;

      const sb = getSupabase();
      if (!sb) return;

      try {
        const { error } = await sb
          .from('blog_posts')
          .delete()
          .eq('id', postId);
        if (error) throw error;

        alert('删除成功');
        window.location.href = '/admin/posts';
      } catch (err) {
        alert('删除失败：' + (err as any).message);
      }
    });
  </script>
</Layout>
