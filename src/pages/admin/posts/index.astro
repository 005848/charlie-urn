---
import Layout from '@layouts/Layout.astro';
---

<Layout title="文章管理 - 管理后台">
  <main class="min-h-screen bg-[#faf9f7]">
    <header class="bg-white border-b border-[#e5e2dd] sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-8">
          <h1 class="text-lg font-serif text-[#2c2a28]">管理后台</h1>
          <nav class="flex gap-6 text-sm">
            <a href="/admin" class="text-[#6b6864] hover:text-[#b8977a] transition-colors">概览</a>
            <a href="/admin/posts" class="text-[#2c2a28] font-medium">文章</a>
            <a href="/admin/comments" class="text-[#6b6864] hover:text-[#b8977a] transition-colors">留言</a>
          </nav>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" target="_blank" class="text-sm text-[#6b6864] hover:text-[#b8977a] transition-colors">查看站点</a>
          <button id="logout-btn" class="text-sm text-[#6b6864] hover:text-red-500 transition-colors">退出</button>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-serif text-[#2c2a28]">文章管理</h2>
        <a href="/admin/posts/edit" class="px-4 py-2 bg-[#2c2a28] text-white text-sm rounded-md hover:bg-[#1a1918] transition-colors">
          + 新建文章
        </a>
      </div>

      <!-- 搜索和筛选 -->
      <div class="bg-white border border-[#e5e2dd] rounded-lg p-4 mb-6 flex gap-4 flex-wrap">
        <input
          type="text"
          id="search-input"
          placeholder="搜索文章标题..."
          class="flex-1 min-w-[200px] px-3 py-2 border border-[#e5e2dd] rounded-md text-sm focus:outline-none focus:border-[#b8977a] transition-colors"
        />
        <select
          id="category-filter"
          class="px-3 py-2 border border-[#e5e2dd] rounded-md text-sm focus:outline-none focus:border-[#b8977a] bg-white"
        >
          <option value="all">全部分类</option>
          <option value="memory">回忆</option>
          <option value="letter">书信</option>
          <option value="essay">随笔</option>
          <option value="photo">影像</option>
          <option value="poem">诗句</option>
        </select>
      </div>

      <!-- 文章列表 -->
      <div class="bg-white border border-[#e5e2dd] rounded-lg overflow-hidden">
        <table class="w-full">
          <thead class="bg-[#faf9f7] border-b border-[#e5e2dd]">
            <tr>
              <th class="text-left px-6 py-3 text-sm font-medium text-[#6b6864]">标题</th>
              <th class="text-left px-6 py-3 text-sm font-medium text-[#6b6864] w-24">分类</th>
              <th class="text-left px-6 py-3 text-sm font-medium text-[#6b6864] w-24">状态</th>
              <th class="text-left px-6 py-3 text-sm font-medium text-[#6b6864] w-32">发布日期</th>
              <th class="text-right px-6 py-3 text-sm font-medium text-[#6b6864] w-32">操作</th>
            </tr>
          </thead>
          <tbody id="posts-table-body">
            <tr>
              <td colspan="5" class="text-center py-12 text-[#9a9690] text-sm">加载中...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 分页 -->
      <div id="pagination" class="flex justify-center items-center gap-2 mt-8">
      </div>
    </div>
  </main>
</Layout>

<script>
  import { createClient, SupabaseClient } from '@supabase/supabase-js';

  let supabase: SupabaseClient | null = null;
  function getSupabase() {
    if (supabase) return supabase;
    const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
    const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
    if (!url || !anonKey) return null;
    supabase = createClient(url, anonKey);
    return supabase;
  }

  // 鉴权
  (async () => {
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data?.session) {
      window.location.href = '/admin/login';
    }
  })();

  const categoryLabels: Record<string, string> = {
    memory: '回忆',
    letter: '书信',
    essay: '随笔',
    photo: '影像',
    poem: '诗句',
  };

  const statusLabels: Record<string, { label: string; class: string }> = {
    published: { label: '已发布', class: 'text-green-600 bg-green-50' },
    draft: { label: '草稿', class: 'text-[#6b6864] bg-[#f0eeeb]' },
  };

  let currentPage = 1;
  const pageSize = 15;

  async function loadPosts() {
    const sb = getSupabase();
    if (!sb) return;

    const search = (document.getElementById('search-input') as HTMLInputElement).value;
    const category = (document.getElementById('category-filter') as HTMLSelectElement).value;

    let query = sb
      .from('blog_posts')
      .select('*', { count: 'exact' });

    if (category && category !== 'all') {
      query = query.eq('category', category);
    }

    if (search) {
      query = query.or(`title.ilike.%${search}%,slug.ilike.%${search}%`);
    }

    const from = (currentPage - 1) * pageSize;
    const to = from + pageSize - 1;

    const { data: posts, count, error } = await query
      .order('pub_date', { ascending: false })
      .range(from, to);

    if (error) {
      console.error('加载文章失败', error);
      return;
    }

    renderPosts(posts || [], count || 0);
  }

  function renderPosts(posts: any[], total: number) {
    const tbody = document.getElementById('posts-table-body')!;
    if (posts.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="text-center py-12 text-[#9a9690] text-sm">暂无文章</td></tr>`;
      return;
    }

    tbody.innerHTML = posts.map(post => {
      const status = statusLabels[post.status] || { label: post.status, class: '' };
      return `
        <tr class="border-b border-[#e5e2dd] hover:bg-[#faf9f7] transition-colors">
          <td class="px-6 py-4">
            <div class="font-medium text-[#2c2a28] text-sm">${escapeHtml(post.title)}</div>
            <div class="text-xs text-[#9a9690] mt-1">${post.slug}</div>
          </td>
          <td class="px-6 py-4 text-sm text-[#6b6864]">${categoryLabels[post.category] || post.category}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 rounded text-xs ${status.class}">${status.label}</span>
          </td>
          <td class="px-6 py-4 text-sm text-[#6b6864]">${formatDate(post.pub_date)}</td>
          <td class="px-6 py-4 text-right">
            <a href="/admin/posts/edit?id=${post.id}" class="text-sm text-[#b8977a] hover:underline mr-3">编辑</a>
            <button class="delete-btn text-sm text-red-500 hover:underline" data-id="${post.id}" data-title="${escapeHtml(post.title)}">删除</button>
          </td>
        </tr>
      `;
    }).join('');

    // 绑定删除事件
    tbody.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLButtonElement;
        const id = target.dataset.id!;
        const title = target.dataset.title!;
        if (confirm(`确定删除文章「${title}」吗？此操作不可恢复。`)) {
          deletePost(id);
        }
      });
    });

    renderPagination(total);
  }

  function renderPagination(total: number) {
    const totalPages = Math.ceil(total / pageSize);
    const pagination = document.getElementById('pagination')!;

    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';
    html += `<button class="page-btn px-3 py-1.5 border border-[#e5e2dd] rounded text-sm ${currentPage === 1 ? 'text-[#9a9690] cursor-not-allowed' : 'text-[#2c2a28] hover:bg-[#f0eeeb]'}" ${currentPage === 1 ? 'disabled' : ''} data-page="${currentPage - 1}">上一页</button>`;

    for (let i = 1; i <= totalPages; i++) {
      if (totalPages > 7 && Math.abs(i - currentPage) > 2 && i !== 1 && i !== totalPages) {
        if (i === 2 || i === totalPages - 1) html += `<span class="px-2 text-[#9a9690]">...</span>`;
        continue;
      }
      html += `<button class="page-btn px-3 py-1.5 border rounded text-sm ${i === currentPage ? 'bg-[#2c2a28] text-white border-[#2c2a28]' : 'border-[#e5e2dd] text-[#2c2a28] hover:bg-[#f0eeeb]'}" data-page="${i}">${i}</button>`;
    }

    html += `<button class="page-btn px-3 py-1.5 border border-[#e5e2dd] rounded text-sm ${currentPage === totalPages ? 'text-[#9a9690] cursor-not-allowed' : 'text-[#2c2a28] hover:bg-[#f0eeeb]'}" ${currentPage === totalPages ? 'disabled' : ''} data-page="${currentPage + 1}">下一页</button>`;

    pagination.innerHTML = html;

    pagination.querySelectorAll('.page-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = parseInt((btn as HTMLButtonElement).dataset.page!, 10);
        if (page !== currentPage && page >= 1 && page <= totalPages) {
          currentPage = page;
          loadPosts();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  }

  async function deletePost(id: string) {
    const sb = getSupabase();
    if (!sb) return;

    const { error } = await sb
      .from('blog_posts')
      .delete()
      .eq('id', id);

    if (error) {
      alert('删除失败：' + error.message);
    } else {
      loadPosts();
    }
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  // 搜索防抖
  let searchTimer: ReturnType<typeof setTimeout>;
  document.getElementById('search-input')?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      currentPage = 1;
      loadPosts();
    }, 300);
  });

  document.getElementById('category-filter')?.addEventListener('change', () => {
    currentPage = 1;
    loadPosts();
  });

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    const sb = getSupabase();
    if (sb) await sb.auth.signOut();
    window.location.href = '/admin/login';
  });

  // 延迟加载（等 session 检查）
  setTimeout(loadPosts, 400);
</script>
