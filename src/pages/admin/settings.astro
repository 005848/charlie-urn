---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="设置 - 管理后台">
  <div class="min-h-screen bg-[#faf9f7] pt-24 pb-16 px-6">
    <div class="max-w-2xl mx-auto">
      <div class="mb-8">
        <a href="/admin" class="text-[#6b6864] text-sm hover:text-[#b8977a] transition-colors">← 返回管理后台</a>
        <h1 class="text-2xl font-serif mt-4 text-[#2c2a28]">账号设置</h1>
      </div>

      <div class="bg-white border border-[#e5e2dd] rounded-lg p-6 space-y-8">
        <div>
          <h3 class="text-base font-medium text-[#2c2a28] mb-4">修改密码</h3>
          <form id="passwordForm" class="space-y-4">
            <div>
              <label class="block text-sm text-[#6b6864] mb-1.5">当前密码</label>
              <input type="password" id="currentPassword" required
                class="w-full px-3 py-2 border border-[#e5e2dd] rounded-md text-sm bg-white text-[#2c2a28] focus:outline-none focus:border-[#b8977a]">
            </div>
            <div>
              <label class="block text-sm text-[#6b6864] mb-1.5">新密码</label>
              <input type="password" id="newPassword" required minlength="6"
                class="w-full px-3 py-2 border border-[#e5e2dd] rounded-md text-sm bg-white text-[#2c2a28] focus:outline-none focus:border-[#b8977a]">
            </div>
            <div>
              <label class="block text-sm text-[#6b6864] mb-1.5">确认新密码</label>
              <input type="password" id="confirmPassword" required minlength="6"
                class="w-full px-3 py-2 border border-[#e5e2dd] rounded-md text-sm bg-white text-[#2c2a28] focus:outline-none focus:border-[#b8977a]">
            </div>
            <button type="submit" class="w-full py-2.5 bg-[#b8977a] text-white text-sm rounded-md hover:bg-[#8c7159] transition-colors">
              修改密码
            </button>
            <p id="passwordMsg" class="text-sm text-center"></p>
          </form>
        </div>

        <div class="border-t border-[#e5e2dd] pt-6">
          <h3 class="text-base font-medium text-[#2c2a28] mb-2">账号信息</h3>
          <div id="accountInfo" class="text-[#6b6864] text-sm space-y-1">
            加载中...
          </div>
        </div>

        <div class="border-t border-[#e5e2dd] pt-6">
          <h3 class="text-base font-medium text-[#2c2a28] mb-2">退出登录</h3>
          <p class="text-[#6b6864] text-sm mb-4">退出当前管理员账号</p>
          <button id="logoutBtn" class="px-5 py-2 border border-[#e5e2dd] text-[#2c2a28] text-sm rounded-md hover:bg-[#f0eeeb] transition-colors">
            退出登录
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabase } from '../../lib/supabase/client';

  const sb = getSupabase();
  (async () => {
    const { data: { user } } = await sb.auth.getUser();
    if (!user) {
      window.location.href = '/admin/login';
    }
  })();

  // 加载账号信息
  async function loadAccountInfo() {
    const infoEl = document.getElementById('accountInfo');
    try {
      const { data: { user } } = await sb.auth.getUser();
      if (user) {
        infoEl.innerHTML = `
          <p>邮箱：<span class="text-[#2c2a28]">${user.email}</span></p>
          <p>用户 ID：<span class="text-[#2c2a28] font-mono text-xs">${user.id}</span></p>
          <p>创建时间：<span class="text-[#2c2a28]">${new Date(user.created_at).toLocaleString('zh-CN')}</span></p>
        `;
      }
    } catch(e) {
      infoEl.textContent = '加载失败';
    }
  }

  // 修改密码
  document.getElementById('passwordForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById('passwordMsg');
    const current = document.getElementById('currentPassword').value;
    const newPwd = document.getElementById('newPassword').value;
    const confirm = document.getElementById('confirmPassword').value;

    if (newPwd !== confirm) {
      msg.textContent = '两次输入的新密码不一致';
      msg.className = 'text-sm text-center text-red-500';
      return;
    }

    const btn = e.target.querySelector('button[type="submit"]');
    btn.textContent = '修改中...';
    btn.disabled = true;
    msg.textContent = '';

    try {
      // 先验证当前密码（通过重新登录验证）
      const { data: { user } } = await sb.auth.getUser();
      const { error: signInError } = await sb.auth.signInWithPassword({
        email: user.email,
        password: current
      });

      if (signInError) {
        throw new Error('当前密码不正确');
      }

      // 更新密码
      const { error } = await sb.auth.updateUser({ password: newPwd });
      if (error) throw error;

      msg.textContent = '密码修改成功！';
      msg.className = 'text-sm text-center text-green-600';
      e.target.reset();
    } catch(err) {
      msg.textContent = err.message || '修改失败';
      msg.className = 'text-sm text-center text-red-500';
    } finally {
      btn.textContent = '修改密码';
      btn.disabled = false;
    }
  });

  // 退出登录
  document.getElementById('logoutBtn').addEventListener('click', async () => {
    if (!confirm('确定要退出登录吗？')) return;
    await sb.auth.signOut();
    localStorage.removeItem('admin_logged_in');
    window.location.href = '/admin/login';
  });

  loadAccountInfo();
</script>
