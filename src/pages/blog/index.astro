---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES } from '../../consts';
---

<Layout title="目录" description="所有文章与记忆的目录">
  <section class="archive-page">
    <div class="archive-header">
      <span class="header-mark">◇ ◇ ◇</span>
      <h1 class="archive-title">记忆目录</h1>
      <p class="archive-subtitle"><span id="post-count">—</span> 篇文字，按时间倒序排列</p>
    </div>

    <!-- 搜索框 -->
    <div class="search-container">
      <div class="search-box">
        <span class="search-icon">⌕</span>
        <input
          type="text"
          id="searchInput"
          placeholder="搜索文章标题或内容..."
          class="search-input"
        />
      </div>
    </div>

    <!-- 分类筛选 -->
    <div class="category-filter" id="category-filter">
      {CATEGORIES.map((cat, index) => (
        <button
          class:list={['category-btn', { active: cat.id === 'all' }]}
          data-category={cat.id}
        >
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-label">{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- 视图切换 -->
    <div class="view-toggle">
      <button class="view-btn active" data-view="list" title="列表视图">
        <span class="view-icon">≡</span>
        <span>列表</span>
      </button>
      <button class="view-btn" data-view="timeline" title="时间线视图">
        <span class="view-icon">⌇</span>
        <span>时间线</span>
      </button>
    </div>

    <!-- 列表视图 -->
    <div class="posts-container list-view" id="postsContainer">
      <p class="text-center text-[#9a9690] text-sm py-12">加载中...</p>
    </div>

    <!-- 时间线视图 -->
    <div class="posts-container timeline-view" id="timelineView" style="display: none;">
      <div class="timeline-line"></div>
      <div id="timeline-items"></div>
    </div>

    <!-- 加载更多 -->
    <div class="load-more-container" id="load-more-container" style="display: none;">
      <button id="load-more-btn" class="load-more-btn">
        加载更多
      </button>
    </div>

    <!-- 无结果提示 -->
    <div class="no-results" id="noResults" style="display: none;">
      <p class="no-results-icon">◇</p>
      <p class="no-results-text">没有找到相关文章</p>
      <p class="no-results-sub">换个关键词试试？</p>
    </div>
  </section>
</Layout>

<script>
  import { createClient, SupabaseClient } from '@supabase/supabase-js';
  import { CATEGORIES } from '../../consts';

  const categoryLabels: Record<string, string> = {};
  for (const cat of CATEGORIES) {
    categoryLabels[cat.id] = cat.label;
  }

  let supabase: SupabaseClient | null = null;
  function getSupabase() {
    if (supabase) return supabase;
    const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
    const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
    if (!url || !anonKey) return null;
    supabase = createClient(url, anonKey);
    return supabase;
  }

  let currentCategory = 'all';
  let currentSearch = '';
  let currentPage = 1;
  const pageSize = 20;
  let totalPosts = 0;
  let allPosts: any[] = [];
  let loading = false;

  const postsContainer = document.getElementById('postsContainer')!;
  const timelineItems = document.getElementById('timeline-items')!;
  const noResults = document.getElementById('noResults')!;
  const loadMoreContainer = document.getElementById('load-more-container')!;
  const loadMoreBtn = document.getElementById('load-more-btn')!;
  const postCountEl = document.getElementById('post-count')!;

  async function loadPosts(reset = false) {
    const sb = getSupabase();
    if (!sb) {
      postsContainer.innerHTML = '<p class="text-center text-[#9a9690] text-sm py-12">数据库未配置</p>';
      return;
    }
    if (loading) return;
    if (reset) {
      currentPage = 1;
      allPosts = [];
      postsContainer.innerHTML = '<p class="text-center text-[#9a9690] text-sm py-12">加载中...</p>';
      timelineItems.innerHTML = '';
    }

    loading = true;
    loadMoreBtn.textContent = '加载中...';
    loadMoreBtn.disabled = true;

    try {
      const from = (currentPage - 1) * pageSize;
      const to = from + pageSize - 1;

      // 有搜索词时优先使用全文搜索 RPC
      if (currentSearch) {
        try {
          const { data: searchResults, error: searchError } = await sb
            .rpc('search_blog_posts', {
              search_term: currentSearch,
              page_limit: pageSize,
              page_offset: from,
              category_filter: currentCategory === 'all' ? null : currentCategory
            });

          if (!searchError && Array.isArray(searchResults)) {
            totalPosts = searchResults.length > 0 ? searchResults[0].total_count : 0;
            const posts = searchResults.map(r => ({
              id: r.id,
              slug: r.slug,
              title: r.title,
              description: r.description,
              category: r.category,
              pub_date: r.pub_date,
              tags: r.tags,
            }));

            allPosts = reset ? posts : [...allPosts, ...posts];
            postCountEl.textContent = String(totalPosts);

            if (allPosts.length === 0) {
              postsContainer.style.display = 'none';
              document.getElementById('timelineView')!.style.display = 'none';
              noResults.style.display = 'block';
              loadMoreContainer.style.display = 'none';
            } else {
              noResults.style.display = 'none';
              renderListView();
              renderTimelineView();

              const hasMore = allPosts.length < totalPosts;
              loadMoreContainer.style.display = hasMore ? 'block' : 'none';
              loadMoreBtn.textContent = '加载更多';
              loadMoreBtn.disabled = !hasMore;
            }
            loading = false;
            return;
          }
          // RPC 失败时降级到 ilike 搜索
          console.warn('全文搜索 RPC 不可用，降级到 ilike 搜索');
        } catch (rpcErr) {
          console.warn('全文搜索 RPC 调用失败，降级到 ilike 搜索:', rpcErr);
        }
      }

      let query = sb
        .from('blog_posts')
        .select('id, slug, title, description, category, pub_date, tags', { count: 'exact' })
        .eq('status', 'published');

      if (currentCategory && currentCategory !== 'all') {
        query = query.eq('category', currentCategory);
      }

      if (currentSearch) {
        query = query.or(`title.ilike.%${currentSearch}%,description.ilike.%${currentSearch}%`);
      }

      const { data: posts, error, count } = await query
        .order('pub_date', { ascending: false })
        .range(from, to);

      if (error) throw error;

      totalPosts = count || 0;
      allPosts = reset ? (posts || []) : [...allPosts, ...(posts || [])];

      postCountEl.textContent = String(totalPosts);

      if (allPosts.length === 0) {
        postsContainer.style.display = 'none';
        document.getElementById('timelineView')!.style.display = 'none';
        noResults.style.display = 'block';
        loadMoreContainer.style.display = 'none';
      } else {
        noResults.style.display = 'none';
        renderListView();
        renderTimelineView();

        const hasMore = allPosts.length < totalPosts;
        loadMoreContainer.style.display = hasMore ? 'block' : 'none';
        loadMoreBtn.textContent = '加载更多';
        loadMoreBtn.disabled = !hasMore;
      }
    } catch (err) {
      console.error('加载文章失败', err);
      postsContainer.innerHTML = '<p class="text-center text-[#9a9690] text-sm py-12">加载失败，请刷新重试</p>';
    } finally {
      loading = false;
    }
  }

  function renderListView() {
    // 按年份分组
    const byYear = new Map<string, any[]>();
    for (const post of allPosts) {
      const year = new Date(post.pub_date).getFullYear().toString();
      if (!byYear.has(year)) byYear.set(year, []);
      byYear.get(year)!.push(post);
    }

    let html = '';
    for (const [year, yearPosts] of Array.from(byYear.entries())) {
      html += `
        <div class="year-group" data-year="${year}">
          <h2 class="year-title">
            <span class="year-num">${year}</span>
            <span class="year-count">${yearPosts.length} 篇</span>
          </h2>
          <div class="year-posts">
            ${yearPosts.map(post => renderPostCard(post)).join('')}
          </div>
        </div>
      `;
    }
    postsContainer.innerHTML = html;
  }

  function renderPostCard(post: any): string {
    const date = new Date(post.pub_date);
    const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
    const catLabel = categoryLabels[post.category] || post.category;
    const tagsHtml = (post.tags || []).slice(0, 3).map((t: string) =>
      `<span class="post-tag">${escapeHtml(t)}</span>`
    ).join('');

    return `
      <a href="/post?slug=${post.slug}" class="post-card animate-fade-in-up">
        <div class="post-card-meta">
          <span class="post-card-category">${catLabel}</span>
          <span class="post-card-date">${dateStr}</span>
        </div>
        <h3 class="post-card-title">${highlightText(post.title)}</h3>
        <p class="post-card-excerpt">${highlightText(post.description || '')}</p>
        ${tagsHtml ? `<div class="post-card-tags">${tagsHtml}</div>` : ''}
        <div class="post-card-footer">
          <span class="read-more">阅读全文 →</span>
        </div>
      </a>
    `;
  }

  function renderTimelineView() {
    const html = allPosts.map((post, index) => {
      const date = new Date(post.pub_date);
      return `
        <div class="timeline-item" data-category="${post.category}" style="animation-delay: ${index * 30}ms">
          <div class="timeline-dot">
            <span class="dot-inner"></span>
          </div>
          <div class="timeline-content">
            <a href="/post?slug=${post.slug}" class="timeline-link">
              <span class="timeline-date">
                ${date.getMonth() + 1}月${date.getDate()}日
              </span>
              <span class="timeline-title">${highlightText(post.title)}</span>
            </a>
          </div>
        </div>
      `;
    }).join('');
    timelineItems.innerHTML = html;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  // 分类切换
  document.querySelectorAll<HTMLButtonElement>('.category-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCategory = btn.dataset.category || 'all';
      loadPosts(true);
    });
  });

  // 视图切换
  document.querySelectorAll<HTMLButtonElement>('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view || 'list';
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      if (view === 'timeline') {
        postsContainer.style.display = 'none';
        document.getElementById('timelineView')!.style.display = 'block';
      } else {
        postsContainer.style.display = 'block';
        document.getElementById('timelineView')!.style.display = 'none';
      }
    });
  });

  // 搜索防抖
  let searchTimer: ReturnType<typeof setTimeout>;
  document.getElementById('searchInput')?.addEventListener('input', (e) => {
    clearTimeout(searchTimer);
    const val = (e.target as HTMLInputElement).value.trim();
    searchTimer = setTimeout(() => {
      currentSearch = val;
      loadPosts(true);
    }, 300);
  });

  // 加载更多
  loadMoreBtn.addEventListener('click', () => {
    currentPage++;
    loadPosts(false);
  });

  // 关键词高亮
  function highlightText(text: string): string {
    if (!currentSearch || !text) return escapeHtml(text);
    const safeText = escapeHtml(text);
    const escapedSearch = currentSearch.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${escapedSearch})`, 'gi');
    return safeText.replace(regex, '<mark class="search-highlight">$1</mark>');
  }

  // URL 参数初始化
  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('category');
  if (catParam && CATEGORIES.some(c => c.id === catParam)) {
    currentCategory = catParam;
    document.querySelectorAll('.category-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.category === catParam);
    });
  }

  loadPosts(true);
</script>

<style>
.archive-page {
  max-width: 720px;
  margin: 0 auto;
  padding: 60px 24px;
}

.archive-header {
  text-align: center;
  margin-bottom: 48px;
}

.header-mark {
  display: block;
  font-size: 0.8rem;
  color: var(--color-accent-primary);
  letter-spacing: 0.5em;
  margin-bottom: 16px;
}

.archive-title {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 0.1em;
  margin-bottom: 12px;
}

.archive-subtitle {
  font-size: 0.9rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.05em;
}

/* Search */
.search-container {
  margin-bottom: 32px;
}

.search-box {
  position: relative;
  max-width: 400px;
  margin: 0 auto;
}

.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-text-tertiary);
  font-size: 1.1rem;
}

.search-input {
  width: 100%;
  padding: 12px 16px 12px 44px;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: white;
  font-size: 0.9rem;
  color: var(--color-text-primary);
  transition: all 0.3s ease;
  font-family: inherit;
}

.search-input:focus {
  outline: none;
  border-color: var(--color-accent-primary);
  box-shadow: 0 0 0 3px rgba(184, 151, 122, 0.1);
}

.search-input::placeholder {
  color: var(--color-text-quaternary, #c4c0b8);
}

/* Category Filter */
.category-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  margin-bottom: 32px;
}

.category-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  background: white;
  font-size: 0.85rem;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.category-btn:hover {
  border-color: var(--color-accent-primary);
  color: var(--color-accent-primary);
}

.category-btn.active {
  background: var(--color-text-primary);
  border-color: var(--color-text-primary);
  color: white;
}

.cat-icon {
  font-size: 0.9rem;
}

/* View Toggle */
.view-toggle {
  display: flex;
  justify-content: flex-end;
  gap: 4px;
  margin-bottom: 24px;
}

.view-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  border: none;
  background: transparent;
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
  cursor: pointer;
  border-radius: 6px;
  transition: all 0.3s ease;
  font-family: inherit;
}

.view-btn:hover {
  color: var(--color-text-secondary);
  background: var(--color-bg-secondary);
}

.view-btn.active {
  color: var(--color-text-primary);
  background: var(--color-bg-secondary);
}

.view-icon {
  font-size: 1rem;
}

/* Post Card */
.post-card {
  display: block;
  padding: 20px 0;
  border-bottom: 1px solid var(--color-border-light, #eee);
  text-decoration: none;
  transition: all 0.3s ease;
}

.post-card:last-child {
  border-bottom: none;
}

.post-card:hover {
  padding-left: 8px;
}

.post-card-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
}

.post-card-category {
  color: var(--color-accent-primary);
  font-size: 0.75rem;
  letter-spacing: 0.05em;
}

.post-card-date {
  color: var(--color-text-quaternary, #c4c0b8);
}

.post-card-title {
  font-size: 1.15rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 6px;
  line-height: 1.5;
  transition: color 0.3s ease;
}

.post-card:hover .post-card-title {
  color: var(--color-accent-primary);
}

.post-card-excerpt {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8px;
}

.post-card-tags {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}

.post-tag {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  background: var(--color-bg-secondary);
  padding: 2px 8px;
  border-radius: 4px;
}

.post-card-footer {
  font-size: 0.85rem;
  color: var(--color-accent-primary);
  opacity: 0;
  transform: translateX(-8px);
  transition: all 0.3s ease;
}

.post-card:hover .post-card-footer {
  opacity: 1;
  transform: translateX(0);
}

.read-more {
  font-size: 0.85rem;
}

/* Year Group */
.year-group {
  margin-bottom: 48px;
}

.year-title {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--color-border);
}

.year-num {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--color-text-primary);
}

.year-count {
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
}

/* Timeline View */
.timeline-view {
  position: relative;
  padding-left: 30px;
  padding-top: 8px;
}

.timeline-line {
  position: absolute;
  left: 7px;
  top: 0;
  bottom: 0;
  width: 1px;
  background: var(--color-border);
}

.timeline-item {
  position: relative;
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}

.timeline-dot {
  position: absolute;
  left: -30px;
  top: 6px;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: var(--color-bg-primary);
  border: 2px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.timeline-item:hover .timeline-dot {
  border-color: var(--color-accent-primary);
}

.dot-inner {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-accent-primary);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.timeline-item:hover .dot-inner {
  opacity: 1;
}

.timeline-content {
  padding-left: 4px;
}

.timeline-link {
  display: flex;
  align-items: baseline;
  gap: 16px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.timeline-item:hover .timeline-link {
  transform: translateX(4px);
}

.timeline-date {
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  min-width: 60px;
}

.timeline-title {
  font-size: 0.95rem;
  color: var(--color-text-primary);
  transition: color 0.3s ease;
}

.timeline-item:hover .timeline-title {
  color: var(--color-accent-primary);
}

/* No Results */
.no-results {
  text-align: center;
  padding: 60px 0;
}

.no-results-icon {
  font-size: 2rem;
  color: var(--color-text-quaternary, #c4c0b8);
  margin-bottom: 16px;
}

.no-results-text {
  font-size: 1rem;
  color: var(--color-text-secondary);
  margin-bottom: 8px;
}

.no-results-sub {
  font-size: 0.85rem;
  color: var(--color-text-tertiary);
}

/* Load More */
.load-more-container {
  text-align: center;
  margin-top: 32px;
}

.load-more-btn {
  padding: 10px 32px;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  background: white;
  font-size: 0.85rem;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.load-more-btn:hover:not(:disabled) {
  border-color: var(--color-accent-primary);
  color: var(--color-accent-primary);
}

.load-more-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Responsive */
@media (max-width: 640px) {
  .archive-page {
    padding: 40px 20px;
  }

  .archive-title {
    font-size: 1.8rem;
  }

  .category-filter {
    gap: 6px;
  }

  .category-btn {
    padding: 6px 12px;
    font-size: 0.8rem;
  }

  .view-toggle {
    justify-content: center;
  }

  .timeline-view {
    padding-left: 24px;
  }

  .timeline-line {
    left: 5px;
  }

  .timeline-dot {
    left: -24px;
    width: 11px;
    height: 11px;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 搜索高亮 */
.search-highlight {
  background: linear-gradient(120deg, #d4c4b0 0%, #d4c4b0 100%);
  background-repeat: no-repeat;
  background-size: 100% 40%;
  background-position: 0 90%;
  color: #2c2a28;
  font-weight: 500;
  padding: 0 2px;
  border-radius: 2px;
}
</style>
