---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import Guestbook from '../components/Guestbook.astro';
import { CATEGORIES } from '../consts';

// 静态构建时用占位，实际数据由客户端 JS 从 API 动态加载
const latestPosts: any[] = [];
---

<Layout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-particles">
        <span class="particle p1"></span>
        <span class="particle p2"></span>
        <span class="particle p3"></span>
        <span class="particle p4"></span>
        <span class="particle p5"></span>
        <span class="particle p6"></span>
        <span class="particle p7"></span>
      </div>
      <div class="hero-glow"></div>
      <div class="hero-glow-secondary"></div>
      <div class="hero-vignette"></div>
      <div class="hero-horizontal-line hero-line-top"></div>
      <div class="hero-horizontal-line hero-line-bottom"></div>
      <div class="hero-side-decoration hero-side-left">
        <div class="hero-side-dot"></div>
        <div class="hero-side-line"></div>
        <div class="hero-side-dot"></div>
      </div>
      <div class="hero-side-decoration hero-side-right">
        <div class="hero-side-dot"></div>
        <div class="hero-side-line"></div>
        <div class="hero-side-dot"></div>
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-symbol animate-fade-in">
        <span class="symbol-ornament left">◇</span>
        <span class="symbol-dot animate-breathe"></span>
        <span class="symbol-ornament right">◇</span>
      </div>

      <h1 class="hero-title animate-fade-in-up">
        Charlie的电子骨灰盒
      </h1>

      <p class="hero-subtitle animate-fade-in-up delay-200">
        一个存放记忆与思念的数字空间
      </p>

      <p class="hero-quote animate-fade-in-up delay-300">
        "时光会带走很多东西，<br />但文字会替我们记住。"
      </p>

      <div class="hero-meta animate-fade-in-up delay-400">
        <div class="meta-item">
          <span class="meta-num" id="stat-post-count">—</span>
          <span class="meta-label">篇文章</span>
        </div>
        <span class="meta-divider">·</span>
        <div class="meta-item">
          <span class="meta-num" id="stat-comment-count">—</span>
          <span class="meta-label">条留言</span>
        </div>
        <span class="meta-divider">·</span>
        <div class="meta-item">
          <span class="meta-num" id="stat-days-count">—</span>
          <span class="meta-label">天记忆</span>
        </div>
      </div>

      <div class="hero-scroll animate-fade-in-up delay-500">
        <span class="scroll-text">向下翻阅</span>
        <span class="scroll-line"></span>
      </div>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="latest-section">
    <div class="section-inner">
      <div class="section-heading">
        <span class="heading-mark">—</span>
        <h2 class="heading-title">最近的文字</h2>
        <span class="heading-sub">Latest Memories</span>
      </div>

      <!-- 今日纪念 + 随机回忆 -->
      <div class="today-memorial" id="today-memorial" style="display:none;">
        <div class="memorial-icon">🕯️</div>
        <div class="memorial-text">
          <span class="memorial-label">今日纪念</span>
          <span class="memorial-title" id="memorial-title"></span>
        </div>
        <span class="memorial-years" id="memorial-years"></span>
      </div>

      <div class="random-memory-bar">
        <button id="random-memory-btn" class="random-memory-btn">
          <span class="random-icon">🎲</span>
          <span>随机一篇回忆</span>
        </button>
      </div>

      <div id="latest-posts-container" class="posts-grid">
        <p class="text-center text-[#9a9690] text-sm col-span-full py-12">加载中...</p>
      </div>

      <div class="section-cta">
        <a href="/blog" class="cta-link">
          <span>浏览全部文章</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Photo Wall / 影像墙 -->
  <section class="photo-wall-section">
    <div class="section-inner">
      <div class="section-heading">
        <span class="heading-mark">—</span>
        <h2 class="heading-title">影像记忆</h2>
        <span class="heading-sub">Photo Memories</span>
      </div>
      <div id="photo-wall-container" class="photo-wall">
        <p class="text-center text-tertiary text-sm col-span-full py-12">加载中...</p>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="categories-section">
    <div class="section-inner">
      <div class="section-heading">
        <span class="heading-mark">—</span>
        <h2 class="heading-title">记忆的分类</h2>
        <span class="heading-sub">Categories</span>
      </div>

      <div class="categories-grid" id="categories-grid">
        {CATEGORIES.filter(c => c.id !== 'all').map((cat, index) => (
          <a href={`/blog?category=${cat.id}`} class="category-card" style={`animation-delay: ${index * 100}ms`}>
            <span class="cat-icon">{cat.icon}</span>
            <span class="cat-name">{cat.label}</span>
            <span class="cat-count" data-cat-id={cat.id}>— 篇</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline Teaser -->
  <section class="timeline-teaser">
    <div class="section-inner">
      <div class="timeline-content">
        <div class="timeline-quote">
          <p className="quote-text">
            "人的一生会死去两次，<br />
            第一次是停止呼吸的时候，<br />
            第二次是最后一个记得他的人忘记的时候。"
          </p>
          <p className="quote-source">— 《寻梦环游记》</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Guest Messages -->
  <section class="latest-messages-section">
    <div class="section-inner">
      <div class="section-heading">
        <span class="heading-mark">—</span>
        <h2 class="heading-title">最近的思念</h2>
        <span class="heading-sub">Latest Thoughts</span>
      </div>

      <div id="latest-messages-container" class="latest-messages">
        <p class="text-center text-tertiary text-sm py-8">加载中...</p>
      </div>

      <div class="section-cta">
        <a href="#guestbook" class="cta-link">
          <span>写下你的思念</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Guestbook -->
  <Guestbook />
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const categoryLabels: Record<string, string> = {
    memory: '回忆',
    letter: '书信',
    essay: '随笔',
    photo: '影像',
    poem: '诗句',
  };

  function getSupabaseClient() {
    const url = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-url"]')?.content || '';
    const anonKey = document.querySelector<HTMLMetaElement>('meta[name="x-supabase-anon-key"]')?.content || '';
    if (!url || !anonKey) return null;
    return createClient(url, anonKey);
  }

  async function loadHomeData() {
    const supabase = getSupabaseClient();
    if (!supabase) {
      console.warn('[Supabase] 未配置');
      return;
    }

    try {
      // 加载最近 6 篇文章（含封面图）
      const { data: posts, error, count } = await supabase
        .from('blog_posts')
        .select('id, slug, title, description, category, pub_date, tags, cover_image, mood, weather', { count: 'exact' })
        .eq('status', 'published')
        .order('pub_date', { ascending: false })
        .range(0, 5);

      if (error) throw error;

      // 更新统计数
      const countEl = document.getElementById('stat-post-count');
      if (countEl && count != null) countEl.textContent = String(count);

      const wordEl = document.getElementById('stat-word-count');
      if (wordEl) wordEl.textContent = '∞';

      // 保存到全局数组用于随机回忆
      if (posts) allPosts.push(...posts);

      // 渲染文章卡片（第一篇大卡 + 其余小卡）
      const container = document.getElementById('latest-posts-container');
      if (container) {
        if (!posts || posts.length === 0) {
          container.innerHTML = `<p class="text-center text-[#9a9690] text-sm col-span-full py-12">暂无文章</p>`;
        } else {
          const featured = posts[0];
          const rest = posts.slice(1);

          let html = `
            <!-- Featured Large Card -->
            <a href="/post?slug=${featured.slug}" class="featured-card animate-fade-in-up">
              <div class="featured-image">
                ${featured.cover_image
                  ? `<img src="${featured.cover_image}" alt="${escapeHtml(featured.title)}" loading="lazy">`
                  : `<div class="featured-image-placeholder">
                       <span class="placeholder-icon">❖</span>
                     </div>`
                }
                <div class="featured-badge">最新</div>
              </div>
              <div class="featured-content">
                <div class="featured-meta">
                  <span class="featured-category">${categoryLabels[featured.category] || featured.category}</span>
                  <span class="featured-dot">·</span>
                  <span class="featured-date">${formatDate(featured.pub_date)}</span>
                  ${featured.mood ? `<span class="featured-dot">·</span><span class="featured-mood">${featured.mood}</span>` : ''}
                </div>
                <h3 class="featured-title">${escapeHtml(featured.title)}</h3>
                <p class="featured-excerpt">${escapeHtml(featured.description || '')}</p>
                <div class="featured-footer">
                  <span class="read-more">继续阅读 →</span>
                </div>
              </div>
            </a>
          `;

          if (rest.length > 0) {
            html += `<div class="small-cards-grid">`;
            html += rest.map((post: any) => `
              <a href="/post?slug=${post.slug}" class="post-card post-card--small animate-fade-in-up">
                ${post.cover_image
                  ? `<div class="post-card-cover">
                       <img src="${post.cover_image}" alt="${escapeHtml(post.title)}" loading="lazy">
                     </div>`
                  : ''
                }
                <div class="post-card-body">
                  <div class="post-card-meta">
                    <span class="post-card-category">${categoryLabels[post.category] || post.category}</span>
                    <span class="post-card-date">${formatDate(post.pub_date)}</span>
                  </div>
                  <h3 class="post-card-title">${escapeHtml(post.title)}</h3>
                  <p class="post-card-excerpt">${escapeHtml(post.description || '')}</p>
                </div>
              </a>
            `).join('');
            html += `</div>`;
          }

          container.innerHTML = html;
        }
      }

      // 加载全部文章用于随机回忆
      const { data: allPostsData, error: allError } = await supabase
        .from('blog_posts')
        .select('category')
        .eq('status', 'published');

      if (!allError && allPostsData) {
        const counts: Record<string, number> = {};
        for (const p of allPostsData) {
          counts[p.category] = (counts[p.category] || 0) + 1;
        }
        document.querySelectorAll<HTMLSpanElement>('.cat-count[data-cat-id]').forEach(el => {
          const catId = el.dataset.catId!;
          el.textContent = `${counts[catId] || 0} 篇`;
        });
      }
      // 加载影像墙
      loadPhotoWall(supabase);

    } catch (err) {
      console.error('加载文章失败', err);
      const container = document.getElementById('latest-posts-container');
      if (container) {
        container.innerHTML = `<p class="text-center text-[#9a9690] text-sm col-span-full py-12">加载失败，请刷新重试</p>`;
      }
    }

    // 加载留言统计和最新留言
    loadGuestbookData(supabase);

    // 计算运行天数
    calculateDays();
  }

  // 加载影像墙
  async function loadPhotoWall(supabase: any) {
    try {
      const { data: posts } = await supabase
        .from('blog_posts')
        .select('id, slug, title, cover_image')
        .eq('status', 'published')
        .not('cover_image', 'is', null)
        .order('pub_date', { ascending: false })
        .limit(12);

      const container = document.getElementById('photo-wall-container');
      if (!container) return;

      if (!posts || posts.length === 0) {
        container.style.display = 'none';
        return;
      }

      container.innerHTML = posts.map((post: any, index: number) => `
        <a href="/post?slug=${post.slug}" class="photo-wall-item animate-fade-in-up" style="animation-delay: ${index * 60}ms">
          <img src="${post.cover_image}" alt="${escapeHtml(post.title)}" loading="lazy">
          <div class="photo-wall-overlay">
            <span class="photo-wall-title">${escapeHtml(post.title)}</span>
          </div>
        </a>
      `).join('');
    } catch (err) {
      console.error('加载影像墙失败', err);
    }
  }

  // 加载留言数据
  async function loadGuestbookData(supabase: any) {
    try {
      // 统计留言总数
      const { count } = await supabase
        .from('guestbook_comments')
        .select('*', { count: 'exact', head: true })
        .eq('status', 'approved');

      const commentCountEl = document.getElementById('stat-comment-count');
      if (commentCountEl && count != null) commentCountEl.textContent = String(count);

      // 加载最新 5 条留言
      const { data: messages } = await supabase
        .from('guestbook_comments')
        .select('*')
        .eq('status', 'approved')
        .order('created_at', { ascending: false })
        .limit(5);

      const container = document.getElementById('latest-messages-container');
      if (!container) return;

      if (!messages || messages.length === 0) {
        container.innerHTML = `<p class="text-center text-tertiary text-sm py-8">还没有人留下思念</p>`;
        return;
      }

      container.innerHTML = messages.map((msg: any, index: number) => `
        <div class="message-card animate-fade-in-up" style="animation-delay: ${index * 80}ms">
          <div class="message-author">
            <span class="author-name">${escapeHtml(msg.author_name || '匿名访客')}</span>
            <span class="message-date">${formatDate(msg.created_at)}</span>
          </div>
          <p class="message-content">${escapeHtml(msg.content || '')}</p>
        </div>
      `).join('');
    } catch (err) {
      console.error('加载留言失败', err);
      const container = document.getElementById('latest-messages-container');
      if (container) {
        container.innerHTML = `<p class="text-center text-tertiary text-sm py-8">加载失败</p>`;
      }
    }
  }

  // 计算运行天数（以最早一篇文章的发布日期为起点，没有则用当前日期）
  async function calculateDays() {
    const supabase = getSupabaseClient();
    if (!supabase) return;

    try {
      const { data } = await supabase
        .from('blog_posts')
        .select('pub_date')
        .eq('status', 'published')
        .order('pub_date', { ascending: true })
        .limit(1);

      let startDate: Date;
      if (data && data.length > 0 && data[0].pub_date) {
        startDate = new Date(data[0].pub_date);
      } else {
        startDate = new Date();
      }

      const now = new Date();
      const diffTime = Math.abs(now.getTime() - startDate.getTime());
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;

      const daysEl = document.getElementById('stat-days-count');
      if (daysEl) daysEl.textContent = String(diffDays);
    } catch {
      // 忽略
    }
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  // 随机回忆
  const allPosts: any[] = [];
  
  async function loadMemorialDates() {
    const supabase = getSupabaseClient();
    if (!supabase) return;
    try {
      const { data } = await supabase
        .from('memorial_dates')
        .select('*')
        .order('sort_order', { ascending: true });
      
      if (data && data.length > 0) {
        const today = new Date();
        const todayStr = `${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        
        const todayMemorial = data.find((m: any) => {
          const d = new Date(m.date);
          return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` === todayStr;
        });
        
        if (todayMemorial) {
          const memorialEl = document.getElementById('today-memorial');
          const titleEl = document.getElementById('memorial-title');
          const yearsEl = document.getElementById('memorial-years');
          if (memorialEl && titleEl && yearsEl) {
            memorialEl.style.display = 'flex';
            titleEl.textContent = todayMemorial.title;
            const years = today.getFullYear() - new Date(todayMemorial.date).getFullYear();
            yearsEl.textContent = `${years} 周年`;
          }
        }
      }
    } catch(e) { console.log('纪念日历加载失败', e); }
  }

  // 随机回忆
  const randomBtn = document.getElementById('random-memory-btn');
  if (randomBtn) {
    randomBtn.addEventListener('click', () => {
      if (allPosts.length === 0) return;
      const random = allPosts[Math.floor(Math.random() * allPosts.length)];
      window.location.href = `/post?slug=${random.slug}`;
    });
  }

  loadHomeData();
  loadMemorialDates();
</script>

<style>
/* Hero Section */
.hero {
  position: relative;
  min-height: calc(100vh - 72px);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 80px 24px;
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(
    ellipse at center,
    rgba(184, 151, 122, 0.12) 0%,
    rgba(212, 196, 176, 0.06) 40%,
    transparent 70%
  );
  border-radius: 50%;
  filter: blur(40px);
}

.hero-glow-secondary {
  position: absolute;
  bottom: 10%;
  left: 20%;
  width: 300px;
  height: 300px;
  background: radial-gradient(
    circle,
    rgba(184, 151, 122, 0.08) 0%,
    transparent 70%
  );
  border-radius: 50%;
  filter: blur(30px);
}

.hero-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    transparent 40%,
    rgba(44, 42, 40, 0.03) 100%
  );
  pointer-events: none;
}

.hero-horizontal-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--color-border) 20%,
    var(--color-border) 80%,
    transparent 100%
  );
  opacity: 0.6;
}

.hero-line-top { top: 25%; }
.hero-line-bottom { bottom: 25%; }

.hero-side-decoration {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12px;
  opacity: 0.4;
}

.hero-side-left { left: 40px; }
.hero-side-right { right: 40px; }

.hero-side-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: var(--color-accent-primary);
}

.hero-side-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(
    180deg,
    var(--color-accent-primary) 0%,
    transparent 100%
  );
  margin: 0 auto;
}

.hero-particles {
  position: absolute;
  inset: 0;
}

.particle {
  position: absolute;
  width: 4px;
  height: 4px;
  background-color: var(--color-accent-primary);
  border-radius: 50%;
  opacity: 0;
  animation: float 8s ease-in-out infinite;
}

.p1 { top: 20%; left: 20%; animation-delay: 0s; }
.p2 { top: 60%; left: 15%; animation-delay: 2s; width: 3px; height: 3px; }
.p3 { top: 30%; right: 25%; animation-delay: 4s; }
.p4 { top: 70%; right: 20%; animation-delay: 1s; width: 3px; height: 3px; }
.p5 { top: 80%; left: 40%; animation-delay: 3s; }
.p6 { top: 15%; left: 60%; animation-delay: 5s; width: 2px; height: 2px; }
.p7 { top: 45%; right: 35%; animation-delay: 2.5s; width: 2px; height: 2px; }

@keyframes float {
  0%, 100% { opacity: 0; transform: translateY(20px); }
  50% { opacity: 0.6; transform: translateY(-20px); }
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 680px;
}

.hero-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 32px;
}

.symbol-ornament {
  color: var(--color-accent-primary);
  font-size: 0.8rem;
  opacity: 0.6;
}

.symbol-dot {
  width: 12px;
  height: 12px;
  background-color: var(--color-accent-primary);
  border-radius: 50%;
  box-shadow: 0 0 20px rgba(184, 151, 122, 0.5);
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 6vw, 3.2rem);
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 0.08em;
  margin-bottom: 20px;
  line-height: 1.3;
}

.hero-subtitle {
  font-size: 1rem;
  color: var(--color-text-secondary);
  letter-spacing: 0.15em;
  margin-bottom: 48px;
}

.hero-quote {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  line-height: 2;
  color: var(--color-text-secondary);
  font-style: italic;
  margin-bottom: 56px;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-bottom: 64px;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.meta-num {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--color-text-primary);
}

.meta-label {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.1em;
}

.meta-divider {
  color: var(--color-text-tertiary);
  font-size: 0.8rem;
  opacity: 0.5;
